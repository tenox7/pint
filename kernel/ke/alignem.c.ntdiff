+#define MAXIMUM_REFERENCE 32
+
+//
+// Define the kinds of registers a reference moves.
+//
+
+#define INTEGER_REGISTERS 0
+#define SINGLE_REGISTERS 1
+#define DOUBLE_REGISTERS 2
