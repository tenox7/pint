#ntdiff private/ntos/ke/mips/table.stb
=1 1 7
+//    systable.asm
=1 9 3
+//    The system service dispatch table, the number of services and the table of
+//    the bytes of arguments in memory of each service.
=1 23 3
+#include "kxarm.h"
+
+#define TABLE_BEGIN1( t )
+#define TABLE_BEGIN2( t )
+#define TABLE_BEGIN3( t )
+#define TABLE_BEGIN4( t )
=1 37 4
+#define TABLE_ENTRY( l,bias,numargs ) TENTRY Nt##l
+#define TABLE_END( n ) TEND n
+#define ARGTBL_BEGIN ABEGIN
+#define ARGTBL_ENTRY( e0,e1,e2,e3,e4,e5,e6,e7 ) DCB e0,e1,e2,e3,e4,e5,e6,e7
+#define ARGTBL_END END
+
+        MACRO
+        TENTRY $Name
+        IMPORT  $Name
+        DCD     $Name
+        MEND
+
+        MACRO
+        TEND $Last
+        AREA    |.data|, DATA, READWRITE, ALIGN=2
+        EXPORT  KiServiceLimit
+KiServiceLimit
+        DCD     $Last + 1
+        MEND
+
+        MACRO
+        ABEGIN
+        AREA    |.rdata|, DATA, READONLY, ALIGN=2
+        EXPORT  KiArgumentTable
+KiArgumentTable
+        MEND
+
+        AREA    |.rdata|, DATA, READONLY, ALIGN=2
+        EXPORT  KiServiceTable
+KiServiceTable
=1 52 9
