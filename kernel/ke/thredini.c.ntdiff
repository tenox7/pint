#ntdiff PRIVATE/NTOS/KE/MIPS/THREDINI.C PRIVATE/NTOS/KE/ALPHA/THREDINI.C
=1 1 10
+    This module implements the machine dependent function to set the initial
+    context and data alignment handling mode for a thread object.
+
+    ARM port of KE/MIPS/THREDINI.C.
=1 13 9
=1 24 16
+
+#define PSR_MODE_SVC 0x13
+#define PSR_I        0x80
+#define PSR_F        0x40
+#define PSR_A        0x100
+
=1 41 39
+        if the thread is a user thread and will execute in user mode.
=1 82 8
=2 106 12
+        TrFrame = (PKTRAP_FRAME)((InitialStack - sizeof(KTRAP_FRAME)) & 0xfffffff0);
=1 105 29
+        ExFrame->Lr = 0;
+
+    } else {
+        TrFrame = NULL;
+        CxFrame = (PKEXCEPTION_FRAME)((InitialStack -
=1 139 11
+    // The thread starts in supervisor mode with interrupts disabled, which
+    // KiThreadStartup enables as it lowers IRQL to APC_LEVEL; asynchronous
+    // aborts and fast interrupts stay masked, as in all kernel code.
=1 150 3
+    CxFrame->R11 = (ULONG)TrFrame;
+    CxFrame->R4 = (ULONG)ContextRecord;
+    CxFrame->R5 = (ULONG)StartContext;
+    CxFrame->R6 = (ULONG)StartRoutine;
+    CxFrame->R7 = (ULONG)SystemRoutine;
+    CxFrame->Fpscr = 0;
+    CxFrame->Psr = PSR_A | PSR_F | PSR_I | PSR_MODE_SVC;
=1 184 8
+
=1 193 121
