+static ULONG
+RtlpPushPopCode (
+    OUT PUCHAR Code,
+    IN ULONG Mask,
+    IN BOOLEAN Pop
=1 105 6
+    This function makes the unwind code of a push or pop of the integer
+    registers of a mask (bit 15 the program counter, popped by an epilogue
+    into the place of the link register), 16-bit if the instruction is.
=1 136 5
+    BOOLEAN Narrow;
+    ULONG Link;
+
+    Link = Mask & ((1 << LR) | (1 << 15));
+    Mask &= 0x1fff;
+    Narrow = ((Mask & ~0xff) == 0) &&
+             ((Link == 0) || (Link == (ULONG)(1 << (Pop ? 15 : LR))));
+
+    if (Narrow) {
+        Code[0] = (UCHAR)(0xec | (Link != 0));
+        Code[1] = (UCHAR)Mask;
+
+    } else {
+        Mask |= (Link != 0) << 13;
+        Code[0] = (UCHAR)(0x80 | (Mask >> 8));
+        Code[1] = (UCHAR)Mask;
+    }
+
+    return 2;
+}
+
+static ULONG
+RtlpStackAdjustCode (
+    OUT PUCHAR Code,
+    IN ULONG Words
+    )
=1 138 3
+    if (Words <= 0x7f) {
+        Code[0] = (UCHAR)Words;
+        return 1;
+    }
+
+    Code[0] = (UCHAR)(0xe8 | (Words >> 8));
+    Code[1] = (UCHAR)Words;
+    return 2;
+}
