+    PUCHAR CodeEnd;
+    ULONG CodeWords;
+    BOOLEAN EBit;
+    ULONG EpilogueCount;
+    ULONG EpilogueSize;
+    ULONG EpilogueStart;
+    BOOLEAN FBit;
+    ULONG FunctionLength;
+    ULONG Header;
+    ULONG Index;
+    ULONG Offset;
