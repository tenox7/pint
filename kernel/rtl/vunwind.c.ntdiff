#ntdiff PRIVATE/NTOS/RTL/ALPHA/EXDSPTCH.C PRIVATE/NTOS/RTL/MIPS/EXDSPTCH.C
=2 1 6
+    vunwind.c
=1 9 3
+    This module implements the virtual unwind of a procedure call frame for
+    ARM (the RtlVirtualUnwind of RTL\MIPS\EXDSPTCH.C).
+
+    The prologue and epilogues of a function are described by the unwind data
+    Microsoft C for ARM and the ARM assembler (kxarm.h) make: the packed
+    unwind data of a function of canonical form, held in its function table
+    entry, or the unwind codes in the .xdata section. Each unwind code undoes
+    one prologue instruction; the prologue codes are in the reverse of the
+    order of the instructions, an epilogue's in the order of its instructions.
+    The codes of the system, which execute no instruction, describe a machine
+    frame, a context record or a trap frame at the stack pointer, through
+    which the frame of an exception, interrupt or system call is unwound to
+    the interrupted code.
=2 13 14
+
+//
+// Define the system unwind codes, the second byte of the 0xEE code.
+//
+
+#define UNWIND_MACHINE_FRAME 1
+#define UNWIND_CONTEXT 2
+#define UNWIND_TRAP_FRAME 3
+#define UNWIND_REDZONE_LR 4
+
+//
+// Define the maximum length of the unwind codes synthesized from packed
+// unwind data.
+//
+
+#define MAXIMUM_PACKED_CODES 16
+
+//
+// Define the integer registers of a context record by number: r0 - r12, sp,
+// lr and pc.
+//
+
+#define REGISTER(Context, Number) (((PULONG)&(Context)->R0)[Number])
+#define SP 13
+#define LR 14
+
+static ULONG
+RtlpUnwindCodeLength (
+    IN PUCHAR Code,
+    OUT PULONG InstructionSize
=1 105 6
+    This function returns the length of an unwind code and the size of the
+    instruction it describes.
=1 125 3
+    Code - Supplies a pointer to the unwind code.
+
+    InstructionSize - Supplies a pointer to a variable that receives the size
+        in bytes of the instruction, zero for an end code or a system code.
=1 131 3
+    The length of the unwind code in bytes.
=1 136 5
+    UCHAR Op;
+
+    Op = Code[0];
+    if (Op < 0x80) {
+        *InstructionSize = 2;
+        return 1;
+
+    } else if (Op < 0xc0) {
+        *InstructionSize = 4;
+        return 2;
+
+    } else if (Op < 0xd8) {
+        *InstructionSize = 2;
+        return 1;
+
+    } else if (Op < 0xe8) {
+        *InstructionSize = 4;
+        return 1;
+
+    } else if (Op < 0xec) {
+        *InstructionSize = 4;
+        return 2;
+
+    } else if (Op < 0xee) {
+        *InstructionSize = 2;
+        return 2;
+
+    } else if (Op == 0xee) {
+        *InstructionSize = 0;
+        return 2;
+
+    } else if (Op == 0xef) {
+        *InstructionSize = 4;
+        return 2;
+
+    } else if (Op < 0xf5) {
+        *InstructionSize = 0;
+        return 1;
+
+    } else if (Op < 0xf7) {
+        *InstructionSize = 4;
+        return 2;
+
+    } else if (Op == 0xf7) {
+        *InstructionSize = 2;
+        return 3;
+
+    } else if (Op == 0xf8) {
+        *InstructionSize = 2;
+        return 4;
+
+    } else if (Op == 0xf9) {
+        *InstructionSize = 4;
+        return 3;
+
+    } else if (Op == 0xfa) {
+        *InstructionSize = 4;
+        return 4;
+
+    } else if ((Op == 0xfb) || (Op == 0xfd)) {
+        *InstructionSize = 2;
+        return 1;
+
+    } else if ((Op == 0xfc) || (Op == 0xfe)) {
+        *InstructionSize = 4;
+        return 1;
+    }
+
+    *InstructionSize = 0;
+    return 1;
+}
+
+static ULONG
+RtlpUnwindSequenceSize (
+    IN PUCHAR Code,
+    IN PUCHAR CodeEnd,
+    IN BOOLEAN Epilogue
=1 105 6
+    This function returns the size of the instructions a sequence of unwind
+    codes describes. The end code of an epilogue may also describe its final
+    branch.
=1 136 5
+    ULONG Size;
+    ULONG Total;
+
+    Total = 0;
+    while (Code < CodeEnd) {
+        if (Code[0] >= 0xfd) {
+            if (Epilogue && (Code[0] != 0xff)) {
+                Total += (Code[0] == 0xfd) ? 2 : 4;
=1 352 3 -8
+        }
+
+        Code += RtlpUnwindCodeLength(Code, &Size);
+        Total += Size;
+    }
+
+    return Total;
+}
+
+static VOID
+RtlpPopRegisters (
=1 1424 1
+    IN ULONG Mask,
=1 1427 7
+    This function pops the integer registers of a mask, bit n for register n,
+    from the stack of a context, in ascending register order.
=1 136 5
+    ULONG Number;
+    PULONG Sp;
+
+    Sp = (PULONG)ContextRecord->Sp;
+    for (Number = 0; Number <= LR; Number += 1) {
+        if ((Mask & (1 << Number)) == 0) {
+            continue;
+        }
+
=1 1849 1 -8
+            if ((Number >= 4) && (Number <= 11)) {
+                (&ContextPointers->R4)[Number - 4] = Sp;
+
+            } else if (Number == LR) {
+                ContextPointers->Lr = Sp;
=1 395 3
+        REGISTER(ContextRecord, Number) = *Sp++;
+    }
+
+    ContextRecord->Sp = (ULONG)Sp;
+}
+
+static VOID
+RtlpPopFloatingRegisters (
=1 1424 1
+    IN ULONG First,
+    IN ULONG Last,
=1 1427 7
+    This function pops the floating registers First - Last from the stack of
+    a context.
=1 136 5
+    ULONG Number;
+    PULONGLONG Sp;
+
+    Sp = (PULONGLONG)ContextRecord->Sp;
+    for (Number = First; Number <= Last; Number += 1) {
+        if (ARGUMENT_PRESENT(ContextPointers) && (Number >= 8) && (Number <= 15)) {
+            (&ContextPointers->D8)[Number - 8] = Sp;
+        }
+
+        ContextRecord->u.D[Number] = *Sp++;
+    }
+
+    ContextRecord->Sp = (ULONG)Sp;
+}
+
+static BOOLEAN
+RtlpExecuteUnwindCodes (
+    IN PUCHAR Code,
+    IN PUCHAR CodeEnd,
+    IN ULONG SkipSize,
=1 1424 1
=1 1427 7
+    This function executes a sequence of unwind codes on a context, after
+    skipping the codes of the first SkipSize bytes of instructions.
=1 125 3
+    Code - Supplies a pointer to the first unwind code.
+
+    CodeEnd - Supplies a pointer to the end of the unwind codes.
+
+    SkipSize - Supplies the size of the instructions whose codes are skipped.
=1 1465 3
=1 1476 5
+    TRUE if a system code restored the program counter from a frame, FALSE
+    if the return address is in the link register.
=1 136 5
+    PCONTEXT Context;
+    BOOLEAN Frame;
+    ULONG Length;
+    ULONG Number;
+    UCHAR Op;
+    ULONG Size;
+    PKTRAP_FRAME TrapFrame;
+    ULONG Value;
+
+    Frame = FALSE;
+    while (Code < CodeEnd) {
+        Op = Code[0];
+        if (Op >= 0xfd) {
+            break;
+        }
+
+        Length = RtlpUnwindCodeLength(Code, &Size);
+        if (SkipSize != 0) {
+            SkipSize = (SkipSize > Size) ? SkipSize - Size : 0;
+            Code += Length;
+            continue;
+        }
+
+        if (Op < 0x80) {
+
+            //
+            // add sp, sp, #X
+            //
+
+            ContextRecord->Sp += (Op & 0x7f) * 4;
+
+        } else if (Op < 0xc0) {
+
+            //
+            // pop {r0 - r12, lr}
+            //
+
+            Value = ((Op & 0x3f) << 8) | Code[1];
+            RtlpPopRegisters(ContextRecord,
+                             (Value & 0x1fff) | (((Value >> 13) & 1) << LR),
+                             ContextPointers);
+
+        } else if (Op < 0xd0) {
+
+            //
+            // mov sp, rX
+            //
+
+            ContextRecord->Sp = REGISTER(ContextRecord, Op & 0xf);
+
+        } else if (Op < 0xe0) {
+
+            //
+            // pop {r4 - rX, lr}, X = 4 - 7 or 8 - 11
+            //
+
+            Number = (Op & 3) + ((Op < 0xd8) ? 4 : 8);
+            RtlpPopRegisters(ContextRecord,
+                             (((1 << (Number + 1)) - 1) & ~0xf) | (((Op >> 2) & 1) << LR),
+                             ContextPointers);
+
+        } else if (Op < 0xe8) {
+
+            //
+            // vpop {d8 - dX}
+            //
+
+            RtlpPopFloatingRegisters(ContextRecord, 8, 8 + (Op & 7), ContextPointers);
+
+        } else if (Op < 0xec) {
+
+            //
+            // addw sp, sp, #X
+            //
+
+            ContextRecord->Sp += (((Op & 3) << 8) | Code[1]) * 4;
+
+        } else if (Op < 0xee) {
+
+            //
+            // pop {r0 - r7, lr}
+            //
+
+            RtlpPopRegisters(ContextRecord,
+                             Code[1] | ((Op & 1) << LR),
+                             ContextPointers);
+
+        } else if (Op == 0xee) {
+
+            //
+            // A system code: a machine frame, a context record or a trap frame
+            // at the stack pointer, or the link register saved below it.
+            //
+
+            switch (Code[1] & 0xf) {
+            case UNWIND_MACHINE_FRAME :
+                ContextRecord->Pc = ((PULONG)ContextRecord->Sp)[1];
+                ContextRecord->Sp = ((PULONG)ContextRecord->Sp)[0];
+                Frame = TRUE;
+                break;
+
+            case UNWIND_CONTEXT :
+                Context = (PCONTEXT)ContextRecord->Sp;
+                RtlMoveMemory(&ContextRecord->R0, &Context->R0, 17 * sizeof(ULONG));
+                ContextRecord->Fpscr = Context->Fpscr;
+                RtlMoveMemory(&ContextRecord->u.D[0], &Context->u.D[0], sizeof(Context->u.D));
+                Frame = TRUE;
+                break;
+
+            case UNWIND_TRAP_FRAME :
+                TrapFrame = (PKTRAP_FRAME)ContextRecord->Sp;
+                ContextRecord->R0 = TrapFrame->R0;
+                ContextRecord->R1 = TrapFrame->R1;
+                ContextRecord->R2 = TrapFrame->R2;
+                ContextRecord->R3 = TrapFrame->R3;
+                ContextRecord->R12 = TrapFrame->R12;
+                ContextRecord->Lr = TrapFrame->Lr;
+                ContextRecord->Pc = TrapFrame->Pc;
+                ContextRecord->Cpsr = TrapFrame->Cpsr;
+                ContextRecord->Fpscr = TrapFrame->Fpscr;
+                ContextRecord->Sp = TrapFrame->Sp;
+                Frame = TRUE;
+                break;
+
+            case UNWIND_REDZONE_LR :
+                ContextRecord->Lr = ((PULONG)ContextRecord->Sp)[-2];
+                break;
+            }
+
+        } else if (Op == 0xef) {
+
+            //
+            // ldr lr, [sp], #X
=1 1847 3 -4
+                ContextPointers->Lr = (PULONG)ContextRecord->Sp;
+            }
+
+            ContextRecord->Lr = *(PULONG)ContextRecord->Sp;
+            ContextRecord->Sp += (Code[1] & 0xf) * 4;
+
+        } else if ((Op == 0xf5) || (Op == 0xf6)) {
+
+            //
+            // vpop {dS - dE}
+            //
+
+            Number = (Op == 0xf6) ? 16 : 0;
+            RtlpPopFloatingRegisters(ContextRecord,
+                                     Number + (Code[1] >> 4),
+                                     Number + (Code[1] & 0xf),
+                                     ContextPointers);
+
+        } else if ((Op == 0xf7) || (Op == 0xf9)) {
+
+            //
+            // add sp, sp, #X
+            //
+
+            ContextRecord->Sp += ((Code[1] << 8) | Code[2]) * 4;
+
+        } else if ((Op == 0xf8) || (Op == 0xfa)) {
+
+            //
+            // add sp, sp, #X
+            //
+
+            ContextRecord->Sp += ((Code[1] << 16) | (Code[2] << 8) | Code[3]) * 4;
+        }
+
+        Code += Length;
+    }
+
+    return Frame;
+}
