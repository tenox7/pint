+    FBit = (BOOLEAN)((Header >> 22) & 1);
+    EpilogueCount = (Header >> 23) & 0x1f;
+    CodeWords = (Header >> 28) & 0xf;
+    Scope = &XData[1];
+    if ((EpilogueCount == 0) && (CodeWords == 0)) {
+        EpilogueCount = XData[1] & 0xffff;
+        CodeWords = (XData[1] >> 16) & 0xff;
