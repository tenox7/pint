#ntdiff PRIVATE/NTOS/RTL/MIPS/EXDSPTCH.C PRIVATE/NTOS/RTL/ALPHA/EXDSPTCH.C PRIVATE/NTOS/RTL/ALPHA/UNWINDR.C PRIVATE/NTOS/RTL/MIPS/NTRTLMIP.H
=1 1 11
+    procedure call frames (the ARM port of RTL\MIPS\EXDSPTCH.C).
+
+    The function tables of ARM images hold image relative addresses, so the
+    function table lookup also returns the base of the image. A virtual unwind
+    (vunwind.c) leaves the program counter of the context at the return
+    address of the call that left the caller, and marks the context unwound to
+    a call; control is then considered to have left the caller two bytes
+    before that address, within the call, so that a call that ends a function
+    or a scope is within it (the MIPS dispatcher takes the delay slot of the
+    jal for the same reason).
+
+    The exception filters and termination handlers of a frame run on the frame
+    of their function: the handlers are given the nonvolatile registers of the
+    frame, as they were where control left the function.
=1 13 14
+
=1 28 17
+// Define the point where control left the function of a context: within the
+// call if the program counter is the return address of a call.
+//
+
+#define CONTROL_PC(Context) \
+    ((((Context)->ContextFlags & CONTEXT_UNWOUND_TO_CALL) != 0) ? \
+        (Context)->Pc - 2 : (Context)->Pc)
=1 58 5
=4 25 17
=1 62 17
=1 712 7
+    );
+
+static VOID
+RtlpCaptureNonVolatileRegisters (
=1 83 1
+    OUT PNONVOLATILE_REGISTERS NonVolatileRegisters
+    )
+
+{
+    RtlMoveMemory(&NonVolatileRegisters->R[0], &ContextRecord->R4, sizeof(NonVolatileRegisters->R));
+    RtlMoveMemory(&NonVolatileRegisters->D[0], &ContextRecord->u.D[8], sizeof(NonVolatileRegisters->D));
+}
