=1 156 86
+//
+// The Ethernet controller of the board is present when the firmware found it and
+// described it in the configuration of the machine: a NetworkController of the
+// internal bus (Hardware\Description\System\MultifunctionAdapter\n\NetworkController).
+//
+
+static
+BOOLEAN
+ArmNetworkControllerPresent(
+    VOID
+    )
+{
+    UNICODE_STRING Name;
+    OBJECT_ATTRIBUTES Attributes;
+    HANDLE Adapters;
+    HANDLE Controller;
+    UCHAR Buffer[sizeof(KEY_BASIC_INFORMATION) + 32 * sizeof(WCHAR)];
+    PKEY_BASIC_INFORMATION Information = (PKEY_BASIC_INFORMATION)Buffer;
+    WCHAR Path[64];
+    ULONG Index;
+    ULONG Length;
+    BOOLEAN Present = FALSE;
+
+    RtlInitUnicodeString(&Name, L"\\Registry\\Machine\\Hardware\\Description\\System\\MultifunctionAdapter");
+    InitializeObjectAttributes(&Attributes, &Name, OBJ_CASE_INSENSITIVE, NULL, NULL);
+    if (!NT_SUCCESS(NtOpenKey(&Adapters, KEY_READ, &Attributes))) {
+        return(FALSE);
+    }
+
+    for (Index = 0; !Present; Index++) {
+
+        if (!NT_SUCCESS(NtEnumerateKey(Adapters,
+                                       Index,
+                                       KeyBasicInformation,
+                                       Information,
+                                       sizeof(Buffer) - sizeof(WCHAR),
+                                       &Length))) {
+            break;
+        }
+
+        Information->Name[Information->NameLength / sizeof(WCHAR)] = L'\0';
+        wsprintf(Path, L"%s\\NetworkController\\0", Information->Name);
+        RtlInitUnicodeString(&Name, Path);
+        InitializeObjectAttributes(&Attributes, &Name, OBJ_CASE_INSENSITIVE, Adapters, NULL);
+        if (NT_SUCCESS(NtOpenKey(&Controller, KEY_READ, &Attributes))) {
+            NtClose(Controller);
+            Present = TRUE;
+        }
+    }
+
+    NtClose(Adapters);
+    return(Present);
+}
=1 110 4
