+//
+// Define the undefined instructions of the Thumb instruction set that serve
+// as traps, as Microsoft C for ARM and Windows on ARM use them: a breakpoint,
+// a debug service (with one of the codes above in r12), an assertion, a fast
+// fail, a cycle counter read and an integer divide by zero.
+//
+
+#define THUMB_BREAKPOINT 0xdefe
+#define THUMB_DEBUG_SERVICE 0xdefd
+#define THUMB_ASSERT 0xdefc
+#define THUMB_FASTFAIL 0xdefb
+#define THUMB_READ_CYCLES 0xdefa
+#define THUMB_DIVIDE_BY_0 0xdef9
=1 103 6
=2 135 15
+// Define length of exception code dispatch vector: the ARMv7-A exception
+// vector has eight entries (reset, undefined, svc, prefetch abort, data
+// abort, reserved, irq and fiq).
+//
+
+#define XCODE_VECTOR_LENGTH 8
=1 128 8
+// Define the interrupt vector the processor's IRQ input is dispatched through:
