# The ARM_SOURCES of the components of the Visual C++ 4.2 run-time (sdktools\vctools\crt):
# their MIPS_SOURCES for ARM, the portable C of what MIPS has in assembler and the ARM
# assembler of what MIPS has in assembler. A line: DIRECTORY SOURCE. DIRECTORY is a
# component, for each of its library types that has MIPS_SOURCES (misc of DLLLIB has none),
# or one library type (crtw32\misc\nt); SOURCE is named from the directory of the library
# type, as there: ..\memccpy.c, ..\arm\chandler.c (the port's, crt\<path>).
crtw32/eh ../arm/trnsctrl.cpp
crtw32/eh ../arm/ehstate.cpp
crtw32/eh ../arm/handlers.asm
crtw32/helper ../arm/sdiv.asm
crtw32/helper ../arm/udiv.asm
crtw32/helper ../arm/sdiv64.asm
crtw32/helper ../arm/udiv64.asm
crtw32/helper ../arm/srsh.asm
crtw32/helper ../arm/ursh.asm
crtw32/helper ../arm/divby0.asm
crtw32/helper ../arm/rthelpc.c
crtw32/helper ../arm/llcvt.c
crtw32/misc ../arm/chandler.c
crtw32/misc ../arm/setjmp.asm
crtw32/misc ../arm/setjmpex.asm
crtw32/misc ../arm/longjmp.asm
crtw32/misc ../arm/jmpuwind.asm
crtw32/startup ../arm/chkstk.asm
crtw32/mbstring ../mbscat.c
crtw32/mbstring ../mbsdup.c
crtw32/string ../memccpy.c
crtw32/string ../memchr.c
