+    {
+        ID.toi_entity = EntityList[(*pIndex)++];
+
+        if ( ID.toi_entity.tei_entity != Entity )
=1 877 3 -4
+
+        ID.toi_class = INFO_CLASS_GENERIC;
+        ID.toi_type  = INFO_TYPE_PROVIDER;
+        ID.toi_id    = ENTITY_TYPE_ID;
+
+        Size = sizeof( Type );
+        Type = 0;
+        RtlZeroMemory( Context, CONTEXT_SIZE );
+
+        Status = TCPQueryInformationEx( TcpHandle, &ID, &Type, &Size,
+                                        Context );
+        if ( ( Status == TDI_SUCCESS ) && ( Type == EntityType ) )
+        {
+            *pId = ID.toi_entity;
+            return ( TRUE );
=1 376 3
+    return ( FALSE );
