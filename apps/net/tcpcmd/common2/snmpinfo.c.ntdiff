+// Name:        FindEntity
+//
+// Description: Finds the next entity of a class that implements a given
+//              protocol, eg the IP entity or the next ARP entity.
+//
+// Parameters:  ulong Entity: class of the entity, eg CL_NL_ENTITY.
+//              ulong EntityType: its protocol, eg CL_NL_IP.
+//              ulong *pIndex: where to start in the entity list; on return,
+//                      where to go on looking.
+//              TDIEntityID *pId: where to return the entity.
+//
+// Returns:     BOOL: TRUE if one was found, FALSE if there are no more.
=1 12 3
+BOOL FindEntity( ulong Entity, ulong EntityType, ulong *pIndex,
+                 TDIEntityID *pId )
+{
+    TDIObjectID  ID;
+    uchar        Context[CONTEXT_SIZE];
+    ulong        Type;
+    ulong        Size;
+    NTSTATUS     Status;
+
