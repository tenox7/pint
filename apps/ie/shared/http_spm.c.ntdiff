+                    lChunkSize = 0;
+                    bChunkExt = FALSE;
+                }
+                else if (lChunk < 0 && !bChunkExt)
+                {
+                    if (isdigit((unsigned char) *p))
+                        lChunkSize = lChunkSize * 16 + (*p - '0');
+                    else if (isxdigit((unsigned char) *p))
