MAJORCOMP=apps
MINORCOMP=ie

TARGETNAME=iebssl
TARGETPATH=obj
TARGETTYPE=LIBRARY

USE_LIBCMT=1

# BearSSL (bearssl.org, MIT), the TLS 1.2 client parts https needs, adapted for
# the 1993 compilers (no 64-bit int; see bearssl\NT31.txt). The upstream inc\,
# src\ and nt31\ folders are flattened into this one directory, so that the
# header farm resolves every header by bare name (and so a component whose
# INCLUDES named its own subdirs cannot truncate them through a farm symlink).
# inline is not a keyword for these compilers, so it is mapped to __inline.
C_DEFINES=-Dinline=__inline

