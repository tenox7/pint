+static BOOL
+UnwindPacked(
+    PUNWIND_MEMORY      Memory,
+    DWORD               ImageBase,
+    DWORD               ControlPc,
+    PRUNTIME_FUNCTION   FunctionEntry,
+    PCONTEXT            Context,
+    PBOOL               Frame
=1 122 6
+    This function unwinds a function of canonical form from its packed unwind
+    data, by the unwind codes of the prologue and epilogue the data describes.
=1 200 4
+    UCHAR   Epilogue[MAXIMUM_PACKED_CODES];
+    UCHAR   Prologue[MAXIMUM_PACKED_CODES];
+    DWORD   Data = FunctionEntry->UnwindData;
+    DWORD   FunctionLength = ((Data >> 2) & 0x7ff) * 2;
+    DWORD   Ret = (Data >> 13) & 3;
+    DWORD   Offset = ControlPc - (ImageBase + (FunctionEntry->BeginAddress & ~1));
+    DWORD   PrologueSize;
+    DWORD   EpilogueSize;
+    DWORD   e;
+    DWORD   p;
+
+    PackedCodes( Data, Prologue, &p, Epilogue, &e );
+
+    //
+    // Within the prologue, undo the instructions that executed (a function
+    // fragment has none); within the epilogue at the end of the function,
+    // execute the instructions that remain; within the body, undo the whole
+    // prologue.
+    //
+
+    if ((Data & 3) == 1) {
+        PrologueSize = UnwindSequenceSize( Prologue, &Prologue[p], FALSE );
+        if (Offset < PrologueSize) {
+            return ExecuteUnwindCodes( Memory, Prologue, &Prologue[p], PrologueSize - Offset, Context, Frame );
=1 385 3
+    if (Ret != 3) {
+        EpilogueSize = UnwindSequenceSize( Epilogue, &Epilogue[e], TRUE );
+        if ((Offset < FunctionLength) && (Offset >= FunctionLength - EpilogueSize)) {
+            return ExecuteUnwindCodes( Memory,
+                                       Epilogue,
+                                       &Epilogue[e],
+                                       Offset - (FunctionLength - EpilogueSize),
+                                       Context,
+                                       Frame );
=1 385 3
+    return ExecuteUnwindCodes( Memory, Prologue, &Prologue[p], 0, Context, Frame );
=1 111 3
+static BOOL
+UnwindFull(
+    PUNWIND_MEMORY      Memory,
+    DWORD               ImageBase,
+    DWORD               ControlPc,
+    PRUNTIME_FUNCTION   FunctionEntry,
+    PCONTEXT            Context,
+    PBOOL               Frame
=1 122 6
+    This function unwinds a function by the unwind codes of its .xdata
+    record: its header, the epilogue scopes and the unwind codes, read from
+    the image.
=1 200 4
+    DWORD   Header[2];
+    DWORD   XData = ImageBase + FunctionEntry->UnwindData;
+    DWORD   FunctionLength;
+    BOOL    EBit;
+    BOOL    FBit;
+    DWORD   EpilogueCount;
+    DWORD   CodeWords;
+    DWORD   ScopeCount;
+    DWORD   HeaderWords = 1;
+    LPDWORD Scope;
+    PUCHAR  Code;
+    PUCHAR  CodeEnd;
+    DWORD   Offset = ControlPc - (ImageBase + (FunctionEntry->BeginAddress & ~1));
+    DWORD   PrologueSize;
+    DWORD   EpilogueSize;
+    DWORD   EpilogueStart;
+    DWORD   Index;
+    BOOL    rval;
+
+    if (!ReadTarget( Memory, XData, Header, sizeof(Header) )) {
+        return FALSE;
+    }
+
+    FunctionLength = (Header[0] & 0x3ffff) * 2;
+    EBit = (Header[0] >> 21) & 1;
+    FBit = (Header[0] >> 22) & 1;
+    EpilogueCount = (Header[0] >> 23) & 0x1f;
+    CodeWords = (Header[0] >> 28) & 0xf;
+    if ((EpilogueCount == 0) && (CodeWords == 0)) {
+        EpilogueCount = Header[1] & 0xffff;
+        CodeWords = (Header[1] >> 16) & 0xff;
+        HeaderWords = 2;
+    }
+
+    ScopeCount = EBit ? 0 : EpilogueCount;
+    Scope = (LPDWORD) LocalAlloc( LPTR, (ScopeCount + CodeWords) * sizeof(DWORD) + 1 );
+    if (!Scope) {
+        return FALSE;
+    }
+
+    if (!ReadTarget( Memory,
+                     XData + HeaderWords * sizeof(DWORD),
+                     Scope,
+                     (ScopeCount + CodeWords) * sizeof(DWORD) )) {
+        LocalFree( Scope );
+        return FALSE;
+    }
+
+    Code = (PUCHAR)&Scope[ScopeCount];
+    CodeEnd = Code + CodeWords * 4;
+
+    //
+    // Within the prologue, undo the instructions that executed (a function
+    // fragment has none).
+    //
+
+    if (!FBit) {
+        PrologueSize = UnwindSequenceSize( Code, CodeEnd, FALSE );
+        if (Offset < PrologueSize) {
+            rval = ExecuteUnwindCodes( Memory, Code, CodeEnd, PrologueSize - Offset, Context, Frame );
+            LocalFree( Scope );
+            return rval;
=1 385 4
+    // Within an epilogue, execute the instructions that remain. A single
+    // epilogue described in the header ends the function.
+    //
+
+    if (EBit) {
+        EpilogueSize = UnwindSequenceSize( Code + EpilogueCount, CodeEnd, TRUE );
+        EpilogueStart = FunctionLength - EpilogueSize;
+        if ((Offset >= EpilogueStart) && (Offset < FunctionLength)) {
+            rval = ExecuteUnwindCodes( Memory, Code + EpilogueCount, CodeEnd, Offset - EpilogueStart, Context, Frame );
+            LocalFree( Scope );
+            return rval;
=1 385 3
+    for (Index = 0; Index < ScopeCount; Index += 1) {
+        EpilogueStart = (Scope[Index] & 0x3ffff) * 2;
+        if (Offset < EpilogueStart) {
+            continue;
+        }
+
+        EpilogueSize = UnwindSequenceSize( Code + (Scope[Index] >> 24), CodeEnd, TRUE );
+        if (Offset < EpilogueStart + EpilogueSize) {
+            rval = ExecuteUnwindCodes( Memory,
+                                       Code + (Scope[Index] >> 24),
+                                       CodeEnd,
+                                       Offset - EpilogueStart,
+                                       Context,
+                                       Frame );
+            LocalFree( Scope );
