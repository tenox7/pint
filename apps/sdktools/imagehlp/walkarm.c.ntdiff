+    // The epilogue codes, in the order of the instructions: the stack
+    // deallocation, the pop of the floating registers, the pop of the integer
+    // registers, the deallocation of the arguments, and the return.
+    //
+
+    if ((StackWords != 0) && !EpilogueFold) {
+        e += StackAdjustCode( &Epilogue[e], StackWords );
+    }
+
+    if (R && (Reg != 7)) {
+        Epilogue[e++] = (UCHAR)(0xe0 | Reg);
+    }
+
+    if (EpilogueMask != 0) {
+        e += PushPopCode( &Epilogue[e], EpilogueMask, TRUE );
+    }
+
+    if (H) {
+        if (L && (Ret == 0)) {
+            Epilogue[e++] = 0xef;
+            Epilogue[e++] = 0x05;
+        } else {
+            Epilogue[e++] = 0x04;
=1 385 3
+    Epilogue[e++] = (UCHAR)((Ret == 1) ? 0xfd : ((Ret == 2) ? 0xfe : 0xff));
+
+    *PrologueEnd = p;
+    *EpilogueEnd = e;
