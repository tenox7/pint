+//
+// The integer registers of a context by number: r0 - r12, sp, lr and pc.
+//
+
+#define REGISTER(Context, Number) (((LPDWORD)&(Context)->R0)[Number])
+#define SP 13
+#define LR 14
+
+//
+// The system unwind codes, the second byte of the 0xEE code.
+//
+
+#define UNWIND_MACHINE_FRAME 1
+#define UNWIND_CONTEXT 2
+#define UNWIND_TRAP_FRAME 3
+#define UNWIND_REDZONE_LR 4
+
+//
+// The maximum length of the unwind codes made from packed unwind data.
+//
+
+#define MAXIMUM_PACKED_CODES 16
+
+//
+// The process whose memory holds the stack and the unwind data.
+//
+
+typedef struct _UNWIND_MEMORY {
+    HANDLE                            hProcess;
+    PREAD_PROCESS_MEMORY_ROUTINE      ReadMemory;
+} UNWIND_MEMORY, *PUNWIND_MEMORY;
