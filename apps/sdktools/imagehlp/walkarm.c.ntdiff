+static BOOL
+ReadTarget(
+    PUNWIND_MEMORY  Memory,
+    DWORD           Address,
+    LPVOID          Buffer,
+    DWORD           Size
+    )
+{
+    DWORD cb;
+
+    if (!Memory->ReadMemory( Memory->hProcess, (LPCVOID)Address, Buffer, Size, &cb )) {
+        return FALSE;
+    }
+
+    return cb == Size;
=2 101 4
+UnwindCodeLength(
+    PUCHAR  Code,
+    LPDWORD InstructionSize
=1 122 6
+    This function returns the length of an unwind code and the size of the
+    instruction it describes, zero for an end code or a system code.
=1 200 4
+    UCHAR Op = Code[0];
+
+    *InstructionSize = 2;
+    if (Op < 0x80) {
+        return 1;
+    }
+
+    if (Op < 0xc0) {
+        *InstructionSize = 4;
+        return 2;
+    }
+
+    if (Op < 0xd8) {
+        return 1;
+    }
+
+    if (Op < 0xe8) {
+        *InstructionSize = 4;
+        return 1;
+    }
+
+    if (Op < 0xec) {
+        *InstructionSize = 4;
+        return 2;
+    }
+
+    if (Op < 0xee) {
+        return 2;
+    }
+
+    if (Op == 0xee) {
+        *InstructionSize = 0;
+        return 2;
+    }
+
+    if (Op == 0xef) {
+        *InstructionSize = 4;
+        return 2;
+    }
+
+    if (Op < 0xf5) {
+        *InstructionSize = 0;
+        return 1;
+    }
+
+    if (Op < 0xf7) {
+        *InstructionSize = 4;
+        return 2;
+    }
+
+    if (Op == 0xf7) {
+        return 3;
+    }
+
+    if (Op == 0xf8) {
+        return 4;
+    }
+
+    if (Op == 0xf9) {
+        *InstructionSize = 4;
+        return 3;
+    }
+
+    if (Op == 0xfa) {
+        *InstructionSize = 4;
+        return 4;
+    }
+
+    if ((Op == 0xfb) || (Op == 0xfd)) {
+        return 1;
+    }
+
+    if ((Op == 0xfc) || (Op == 0xfe)) {
+        *InstructionSize = 4;
+        return 1;
+    }
+
+    *InstructionSize = 0;
+    return 1;
=2 101 4
+UnwindSequenceSize(
+    PUCHAR  Code,
+    PUCHAR  CodeEnd,
+    BOOL    Epilogue
=1 122 6
+    This function returns the size of the instructions a sequence of unwind
+    codes describes. The end code of an epilogue may also describe its final
+    branch.
=1 200 4
+    DWORD Size;
+    DWORD Total = 0;
+
+    while (Code < CodeEnd) {
+        if (Code[0] >= 0xfd) {
+            if (Epilogue && (Code[0] != 0xff)) {
+                Total += (Code[0] == 0xfd) ? 2 : 4;
+            }
+
+            break;
+        }
+
+        Code += UnwindCodeLength( Code, &Size );
+        Total += Size;
+    }
+
+    return Total;
=1 111 3
+static BOOL
+PopRegisters(
+    PUNWIND_MEMORY  Memory,
+    PCONTEXT        Context,
+    DWORD           Mask
=1 122 6
+    This function pops the integer registers of a mask, bit n for register n,
+    from the stack of a context, in ascending register order.
=1 200 4
+    DWORD Number;
+
+    for (Number = 0; Number <= LR; Number += 1) {
+        if ((Mask & (1 << Number)) == 0) {
+            continue;
+        }
+
+        if (!ReadTarget( Memory, Context->Sp, &REGISTER(Context, Number), sizeof(DWORD) )) {
+            return FALSE;
+        }
+
+        Context->Sp += sizeof(DWORD);
=2 703 6
+static BOOL
+PopFloatingRegisters(
+    PUNWIND_MEMORY  Memory,
+    PCONTEXT        Context,
+    DWORD           First,
+    DWORD           Last
=1 122 6
+    This function pops the floating registers First - Last from the stack of
+    a context.
=1 200 4
+    DWORD Number;
+
+    for (Number = First; Number <= Last; Number += 1) {
+        if (!ReadTarget( Memory, Context->Sp, &Context->u.D[Number], sizeof(ULONGLONG) )) {
+            return FALSE;
+        }
+
+        Context->Sp += sizeof(ULONGLONG);
=2 703 6
+static BOOL
+UnwindSystemFrame(
+    PUNWIND_MEMORY  Memory,
+    PCONTEXT        Context,
+    UCHAR           Type,
+    PBOOL           Frame
=1 122 6
+    This function executes a system unwind code: a machine frame, a context
+    record or a trap frame at the stack pointer, or the link register saved
+    below it.
=1 200 4
+    DWORD       MachineFrame[2];
+    CONTEXT     SavedContext;
+    KTRAP_FRAME TrapFrame;
+
+    switch (Type & 0xf) {
+    case UNWIND_MACHINE_FRAME:
+        if (!ReadTarget( Memory, Context->Sp, MachineFrame, sizeof(MachineFrame) )) {
+            return FALSE;
+        }
+
+        Context->Pc = MachineFrame[1];
+        Context->Sp = MachineFrame[0];
+        *Frame = TRUE;
+        return TRUE;
+
+    case UNWIND_CONTEXT:
+        if (!ReadTarget( Memory, Context->Sp, &SavedContext, sizeof(CONTEXT) )) {
+            return FALSE;
+        }
+
+        memcpy( &Context->R0, &SavedContext.R0, 17 * sizeof(DWORD) );
+        Context->Fpscr = SavedContext.Fpscr;
+        memcpy( &Context->u.D[0], &SavedContext.u.D[0], sizeof(SavedContext.u.D) );
+        *Frame = TRUE;
+        return TRUE;
+
+    case UNWIND_TRAP_FRAME:
+        if (!ReadTarget( Memory, Context->Sp, &TrapFrame, sizeof(KTRAP_FRAME) )) {
+            return FALSE;
+        }
+
+        Context->R0    = TrapFrame.R0;
+        Context->R1    = TrapFrame.R1;
+        Context->R2    = TrapFrame.R2;
+        Context->R3    = TrapFrame.R3;
+        Context->R12   = TrapFrame.R12;
+        Context->Lr    = TrapFrame.Lr;
+        Context->Pc    = TrapFrame.Pc;
+        Context->Cpsr  = TrapFrame.Cpsr;
+        Context->Fpscr = TrapFrame.Fpscr;
+        Context->Sp    = TrapFrame.Sp;
+        *Frame = TRUE;
+        return TRUE;
+
+    case UNWIND_REDZONE_LR:
+        return ReadTarget( Memory, Context->Sp - 8, &Context->Lr, sizeof(DWORD) );
=2 703 6
+static BOOL
+ExecuteUnwindCodes(
+    PUNWIND_MEMORY  Memory,
+    PUCHAR          Code,
+    PUCHAR          CodeEnd,
+    DWORD           SkipSize,
+    PCONTEXT        Context,
+    PBOOL           Frame
=1 122 6
+    This function executes a sequence of unwind codes on a context, after
+    skipping the codes of the first SkipSize bytes of instructions. Frame is
+    set if a system code restored the program counter from a frame.
=1 200 4
+    DWORD   Length;
+    DWORD   Number;
+    UCHAR   Op;
+    DWORD   Size;
+    DWORD   Value;
+    BOOL    rval = TRUE;
+
+    *Frame = FALSE;
+    for (; rval && (Code < CodeEnd); Code += Length) {
+        Op = Code[0];
+        if (Op >= 0xfd) {
+            break;
+        }
+
+        Length = UnwindCodeLength( Code, &Size );
+        if (SkipSize != 0) {
+            SkipSize = (SkipSize > Size) ? SkipSize - Size : 0;
+            continue;
+        }
+
+        if (Op < 0x80) {
+            Context->Sp += (Op & 0x7f) * 4;                             // add sp, sp, #X
+
+        } else if (Op < 0xc0) {
+            Value = ((Op & 0x3f) << 8) | Code[1];                       // pop {r0 - r12, lr}
+            rval = PopRegisters( Memory, Context, (Value & 0x1fff) | (((Value >> 13) & 1) << LR) );
+
+        } else if (Op < 0xd0) {
+            Context->Sp = REGISTER(Context, Op & 0xf);                  // mov sp, rX
+
+        } else if (Op < 0xe0) {
+            Number = (Op & 3) + ((Op < 0xd8) ? 4 : 8);                  // pop {r4 - rX, lr}
+            rval = PopRegisters( Memory,
+                                 Context,
+                                 (((1 << (Number + 1)) - 1) & ~0xf) | (((Op >> 2) & 1) << LR) );
+
+        } else if (Op < 0xe8) {
+            rval = PopFloatingRegisters( Memory, Context, 8, 8 + (Op & 7) );   // vpop {d8 - dX}
+
+        } else if (Op < 0xec) {
+            Context->Sp += (((Op & 3) << 8) | Code[1]) * 4;             // addw sp, sp, #X
+
+        } else if (Op < 0xee) {
+            rval = PopRegisters( Memory, Context, Code[1] | ((Op & 1) << LR) );  // pop {r0 - r7, lr}
+
+        } else if (Op == 0xee) {
+            rval = UnwindSystemFrame( Memory, Context, Code[1], Frame );
+
+        } else if (Op == 0xef) {
+            rval = ReadTarget( Memory, Context->Sp, &Context->Lr, sizeof(DWORD) );  // ldr lr, [sp], #X
+            Context->Sp += (Code[1] & 0xf) * 4;
+
+        } else if ((Op == 0xf5) || (Op == 0xf6)) {
+            Number = (Op == 0xf6) ? 16 : 0;                             // vpop {dS - dE}
+            rval = PopFloatingRegisters( Memory, Context, Number + (Code[1] >> 4), Number + (Code[1] & 0xf) );
+
+        } else if ((Op == 0xf7) || (Op == 0xf9)) {
+            Context->Sp += ((Code[1] << 8) | Code[2]) * 4;              // add sp, sp, #X
+
+        } else if ((Op == 0xf8) || (Op == 0xfa)) {
+            Context->Sp += ((Code[1] << 16) | (Code[2] << 8) | Code[3]) * 4;
=1 385 3
