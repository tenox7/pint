#ntdiff private/sdktools/imagehlp/walkalp.c private/sdktools/imagehlp/walkmip.c ../nt35/PRIVATE/SDKTOOLS/IMAGEHLP/WALKALP.C ../nt35/PRIVATE/SDKTOOLS/IMAGEHLP/WALKMIP.C
=1 1 6
+    walkarm.c
=1 8 3
+    This file implements the ARM stack walking api.
+
+    A frame is unwound by the unwind data of its function: the function table
+    entry of the image (.pdata), image relative, with the packed unwind data
+    of a function of canonical form or the address of its .xdata record. The
+    unwind codes are those RtlVirtualUnwind executes; the stack, the unwind
+    data and the frames of the system are read through the read memory
+    routine.
+
+    The entries a function table access routine returns (IMAGE_FUNCTION_ENTRY,
+    from the symbol handler) carry no unwind data, so the walker finds the
+    entry in the exception directory of the image, as RtlLookupFunctionEntry
+    does, with the base the get module base routine gives.
=1 12 11
+#define TARGET_ARM
=2 24 7
+WalkArmInit(
=1 37 4
+    PFUNCTION_TABLE_ACCESS_ROUTINE    FunctionTableAccessRoutine,
+    PGET_MODULE_BASE_ROUTINE          GetModuleBaseRoutine
=1 42 3
+WalkArmNext(
=1 37 4
+    PFUNCTION_TABLE_ACCESS_ROUTINE    FunctionTableAccessRoutine,
+    PGET_MODULE_BASE_ROUTINE          GetModuleBaseRoutine
=3 47 9
=1 60 1
+    PGET_MODULE_BASE_ROUTINE          GetModuleBase
+    );
