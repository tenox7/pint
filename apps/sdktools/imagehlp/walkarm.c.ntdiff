+
+    if (C) {
+        Prologue[p++] = (UCHAR)((R && !PrologueFold) ? 0xfb : 0xfc);
+    }
+
+    if (PrologueMask != 0) {
+        p += PushPopCode( &Prologue[p], PrologueMask, FALSE );
+    }
+
+    if (H) {
+        Prologue[p++] = 0x04;
+    }
+
+    Prologue[p++] = 0xff;
+
