+PushPopCode(
+    PUCHAR  Code,
+    DWORD   Mask,
+    BOOL    Pop
=1 122 6
+    This function makes the unwind code of a push or pop of the integer
+    registers of a mask (bit 15 the program counter, popped by an epilogue
+    into the place of the link register), 16-bit if the instruction is.
=1 200 4
+    DWORD Link = Mask & ((1 << LR) | (1 << 15));
+    BOOL  Narrow;
+
+    Mask &= 0x1fff;
+    Narrow = ((Mask & ~0xff) == 0) &&
+             ((Link == 0) || (Link == (DWORD)(1 << (Pop ? 15 : LR))));
+
+    if (Narrow) {
+        Code[0] = (UCHAR)(0xec | (Link != 0));
+        Code[1] = (UCHAR)Mask;
+        return 2;
+    }
+
+    Mask |= (Link != 0) << 13;
+    Code[0] = (UCHAR)(0x80 | (Mask >> 8));
+    Code[1] = (UCHAR)Mask;
+    return 2;
=2 101 4
+StackAdjustCode(
+    PUCHAR  Code,
+    DWORD   Words
+    )
+{
+    if (Words <= 0x7f) {
+        Code[0] = (UCHAR)Words;
+        return 1;
+    }
+
+    Code[0] = (UCHAR)(0xe8 | (Words >> 8));
+    Code[1] = (UCHAR)Words;
+    return 2;
