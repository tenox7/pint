+static VOID
+PackedCodes(
+    DWORD   Data,
+    PUCHAR  Prologue,
+    LPDWORD PrologueEnd,
+    PUCHAR  Epilogue,
+    LPDWORD EpilogueEnd
=1 122 6
+    This function makes the unwind codes of the prologue and the epilogue the
+    packed unwind data of a function of canonical form describes.
=1 200 4
+    DWORD   Ret = (Data >> 13) & 3;
+    BOOL    H = (Data >> 15) & 1;
+    DWORD   Reg = (Data >> 16) & 7;
+    BOOL    R = (Data >> 19) & 1;
+    BOOL    L = (Data >> 20) & 1;
+    BOOL    C = (Data >> 21) & 1;
+    DWORD   StackAdjust = (Data >> 22) & 0x3ff;
+    BOOL    PrologueFold = FALSE;
+    BOOL    EpilogueFold = FALSE;
+    DWORD   StackWords = StackAdjust;
+    DWORD   PrologueMask = 0;
+    DWORD   EpilogueMask = 0;
+    DWORD   First;
+    DWORD   Last;
+    DWORD   e = 0;
+    DWORD   p = 0;
+
+    //
+    // A stack adjustment of 0x3f4 or more is one to four words, which the
+    // prologue or the epilogue may fold into its push or pop.
+    //
+
+    if (StackAdjust >= 0x3f4) {
+        PrologueFold = (StackAdjust & 4) != 0;
+        EpilogueFold = (StackAdjust & 8) != 0;
+        StackWords = (StackAdjust & 3) + 1;
=1 235 3
+    // The integer registers pushed and popped: r4 - rN, N = 4 + Reg, unless
+    // the floating registers are saved, preceded by the words of a folded
+    // stack adjustment, r11 if a frame chain is made, and the link register,
+    // which the epilogue pops into the program counter if it returns so.
+    //
