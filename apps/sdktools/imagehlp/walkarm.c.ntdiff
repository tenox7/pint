+        First = PrologueFold ? (~StackAdjust & 3) : 4;
+        PrologueMask = ((1 << (Last + 1)) - 1) & ~((1 << First) - 1);
+    }
+
+    if (!R || EpilogueFold) {
+        First = EpilogueFold ? (~StackAdjust & 3) : 4;
+        EpilogueMask = ((1 << (Last + 1)) - 1) & ~((1 << First) - 1);
+    }
+
+    if (C) {
+        PrologueMask |= 1 << 11;
+        EpilogueMask |= 1 << 11;
+    }
+
+    if (L) {
+        PrologueMask |= 1 << LR;
+        if (Ret != 0) {
+            EpilogueMask |= 1 << LR;
+        } else if (!H) {
+            EpilogueMask |= 1 << 15;
=1 385 4
+    // The prologue codes, in the reverse of the order of the instructions:
+    // the stack allocation, the push of the floating registers, the frame
+    // chain, the push of the integer registers and that of the arguments.
+    //
