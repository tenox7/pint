+//
+// The function table entry of an ARM image: the image relative address of
+// the function, with the Thumb state bit set, and its unwind data, which
+// gives the length of the function and of its prologue (walkarm.c).
+//
+
+typedef struct _ARM_FUNCTION_ENTRY {
+    ULONG BeginAddress;
+    ULONG UnwindData;
+} ARM_FUNCTION_ENTRY, *PARM_FUNCTION_ENTRY;
+
+BOOL
+ArmFunctionExtent(
+    DWORD   UnwindData,
+    LPDWORD Record,
+    LPDWORD FunctionLength,
+    LPDWORD PrologueLength
+    );
+
+static VOID
+ArmFunctionEntry(
+    PIMAGE_NT_HEADERS       NtHeaders,
+    PVOID                   MappedBase,
+    PARM_FUNCTION_ENTRY     RuntimeFunction,
+    ULONG                   Base,
+    PIMAGE_FUNCTION_ENTRY   FunctionEntry
+    )
+
+/*++
+
+Routine Description:
+
+    This function makes the debug function table entry of a function of an
+    ARM image mapped as a file, at Base.
=1 19 3
+{
+    DWORD FunctionLength = 0;
+    DWORD PrologueLength = 0;
+    LPDWORD Record = NULL;
+
+    if ((RuntimeFunction->UnwindData & 3) == 0) {
+        Record = (LPDWORD) ImageRvaToVa( NtHeaders, MappedBase, RuntimeFunction->UnwindData, NULL );
+    }
+
+    ArmFunctionExtent( RuntimeFunction->UnwindData, Record, &FunctionLength, &PrologueLength );
+    FunctionEntry->StartingAddress = Base + (RuntimeFunction->BeginAddress & ~1);
+    FunctionEntry->EndingAddress = FunctionEntry->StartingAddress + FunctionLength;
+    FunctionEntry->EndOfPrologue = FunctionEntry->StartingAddress + PrologueLength;
