+static VOID
+OutputOp (PUCHAR Name, ULONG SetFlags, PUCHAR Suffix)
+{
+    OutputString(Name);
+    if (SetFlags) {
+        *pBuf++ = 's';
+    }
+    OutputString(CondName[Cond]);
+    if (Suffix != NULL) {
+        OutputString(Suffix);
+    }
+    BlankFill(OPSTART);
+}
