+
+    } else if (Op < 0x24) {
+
+        //
+        // Load and store, immediate offset: word, byte, halfword.
+        //
+
+        L = (Hw1 >> 11) & 1;
+        if (Op < 0x1c) {
+            Name = L ? "ldr" : "str";
+            Size = 4;
+        } else if (Op < 0x20) {
+            Name = L ? "ldrb" : "strb";
+            Size = 1;
+        } else {
+            Name = L ? "ldrh" : "strh";
+            Size = 2;
+        }
+        OutputOp(Name, FALSE, NULL);
