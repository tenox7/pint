+//
+// The special undefined instructions of Windows on ARM (ntarm.h).
+//
+
+static PUCHAR
+UdfName (ULONG Imm)
+{
+    switch (Imm) {
+    case 0xfe:
+        return "__debugbreak";
+    case 0xfd:
+        return "__debugservice";
+    case 0xfc:
+        return "__assertfail";
+    case 0xfb:
+        return "__fastfail";
+    case 0xfa:
+        return "__rdpmccntr64";
+    case 0xf9:
+        return "__brkdiv0";
+    }
+    return NULL;
+}
