+//
+// A register list, runs of three registers or more as ranges.  The register
+// numbers of a list wrap after 31.
+//
+
+static VOID
+OutputList (PUCHAR Prefix, ULONG First, ULONG Count, ULONG Step, PUCHAR Lane)
+{
+    ULONG Index;
+    ULONG Last;
+
+    *pBuf++ = '{';
+    for (Index = 0; Index < Count; Index = Last + 1) {
+        if (Index != 0) {
+            OutputComma();
+        }
+        Last = Index;
+        while (Step == 1 && Last + 1 < Count && ((First + Last + 1) & 31) != 0) {
+            Last += 1;
+        }
+        if (Last < Index + 2) {
+            Last = Index;
+        }
+        OutputString(Prefix);
+        OutputNumberDecimal((First + Index * Step) & 31);
+        if (Lane != NULL) {
+            OutputString(Lane);
+        }
+        if (Last != Index) {
