+//
+// The ARM registers of a load or store multiple: sp, lr and pc are never
+// part of a range.
+//
+
+static VOID
+OutputRegList (ULONG Mask)
+{
+    ULONG Reg;
+    ULONG Last;
+    BOOLEAN First = TRUE;
+
+    *pBuf++ = '{';
+    for (Reg = 0; Reg < 16; Reg = Last + 1) {
+        Last = Reg;
+        if ((Mask & (1 << Reg)) == 0) {
+            continue;
+        }
+        if (!First) {
+            OutputComma();
+        }
+        First = FALSE;
+        OutputReg(Reg);
+        while (Last < 12 && (Mask & (1 << (Last + 1))) != 0) {
+            Last += 1;
+        }
+        if (Last >= Reg + 2) {
+            *pBuf++ = '-';
+            OutputReg(Last);
+        } else {
+            Last = Reg;
+        }
+    }
+    *pBuf++ = '}';
+}
+
+//
+// The address of a load or store: [Rn,#imm], [Rn,#imm]! or [Rn],#imm.
+//
+
+static VOID
+OutputAddress (ULONG Rn, ULONG Imm, ULONG Add, ULONG Index, ULONG WriteBack, ULONG Size)
+{
+    *pBuf++ = '[';
+    OutputReg(Rn);
+    if (Index) {
+        if (Imm != 0 || !Add) {
+            OutputComma();
+            OutputSignedImm(Imm, Add);
+        }
+        *pBuf++ = ']';
+        if (WriteBack) {
+            *pBuf++ = '!';
+        }
+    } else {
+        *pBuf++ = ']';
+        OutputComma();
+        OutputSignedImm(Imm, Add);
+    }
+
+    EAsize = Size;
+    EAreg = Rn;
+    EAindex = 16;
+    EAoffset = !Index ? 0 : Add ? (LONG)Imm : -(LONG)Imm;
+}
+
+static VOID
+OutputRegisterAddress (ULONG Rn, ULONG Rm, ULONG Shift, ULONG Size)
+{
+    *pBuf++ = '[';
+    OutputReg(Rn);
+    OutputComma();
+    OutputReg(Rm);
+    if (Shift != 0) {
+        OutputString(",lsl ");
+        OutputImm(Shift);
+    }
+    *pBuf++ = ']';
+
+    EAsize = Size;
+    EAreg = Rn;
+    EAindex = Rm;
+    EAshift = Shift;
+    EAoffset = 0;
+}
+
+//
+// A PC relative address (a literal), Align(PC,4) +/- imm.
+//
+
+static VOID
+OutputLiteral (ULONG Imm, ULONG Add, ULONG Size)
+{
+    LONG Offset = Add ? (LONG)Imm : -(LONG)Imm;
+
+    if (!Add && Imm == 0) {
+        OutputString("[pc,#-0]");
+    } else {
+        OutputDisSymbol(Dp, ((InstrOffset + 4) & ~3) + Offset);
+    }
+    EAsize = Size;
+    EAreg = REGPC;
+    EAindex = 16;
+    EAoffset = Offset;
+}
+
+static VOID
+OutputBranch (LONG Offset)
+{
+    OutputDisSymbol(Dp, InstrOffset + 4 + Offset);
+}
+
+//
+// The .w qualifier of a 32-bit instruction that has a 16-bit encoding too.
+// The 16-bit data-processing instructions set the flags outside an IT block
+// alone (Flags16), and the 16-bit loads and stores of a 5-bit offset take
+// low registers (NarrowOffset).
+//
+
+#define Flags16(S)  ((S) == (ULONG)!InItBlock)
+
+static PUCHAR
+Wide (ULONG Narrow)
+{
+    return Narrow ? ".w" : NULL;
+}
+
+static ULONG
+NarrowOffset (ULONG Rt, ULONG Rn, ULONG Imm, ULONG Size)
+{
+    return Rt < 8 && (Imm & (Size - 1)) == 0 &&
+           ((Rn < 8 && Imm <= 31 * Size) || (Size == 4 && Rn == 13 && Imm <= 1020));
+}
+
+//
+// The constant of a data-processing instruction (ThumbExpandImm), and
+// whether a value is one.
+//
+
+static ULONG
+ThumbExpandImm (ULONG Imm12)
+{
+    ULONG Imm8 = Imm12 & 0xff;
+    ULONG Rotation;
+
+    if ((Imm12 & 0xc00) == 0) {
+        switch ((Imm12 >> 8) & 3) {
+        case 0:
+            return Imm8;
+        case 1:
+            return Imm8 | (Imm8 << 16);
+        case 2:
+            return (Imm8 << 8) | (Imm8 << 24);
+        default:
+            return Imm8 * 0x01010101;
+        }
+    }
+    Imm8 = 0x80 | (Imm12 & 0x7f);
+    Rotation = (Imm12 >> 7) & 0x1f;
+    return (Imm8 >> Rotation) | (Imm8 << (32 - Rotation));
+}
+
+static BOOLEAN
+IsModifiedImm (ULONG Value)
+{
+    ULONG Rotation;
+    ULONG Unrotated;
+
+    if (Value < 0x100 || Value == (Value & 0xff) * 0x01010101) {
+        return TRUE;
+    }
+    if ((Value >> 16) == (Value & 0xffff) &&
+        ((Value & 0xff00ff00) == 0 || (Value & 0x00ff00ff) == 0)) {
+        return TRUE;
+    }
+    for (Rotation = 8; Rotation < 32; Rotation++) {
+        Unrotated = (Value << Rotation) | (Value >> (32 - Rotation));
+        if (Unrotated >= 0x80 && Unrotated <= 0xff) {
+            return TRUE;
+        }
+    }
