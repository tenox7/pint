+static VOID
+Thumb16 (VOID)
+{
+    ULONG Op = Hw1 >> 10;
+    ULONG S = !InItBlock;
+    ULONG Rd = Hw1 & 7;
+    ULONG Rn = (Hw1 >> 3) & 7;
+    ULONG Rm = (Hw1 >> 6) & 7;
+    ULONG Opc;
+    ULONG Imm;
+    ULONG L;
+    ULONG Size;
+    PUCHAR Name;
+    static PUCHAR DpName[16] = {
+        "and", "eor", "lsl", "lsr", "asr", "adc", "sbc", "ror",
+        "tst", "rsb", "cmp", "cmn", "orr", "mul", "bic", "mvn"
+        };
+    static PUCHAR LsName[8] = {
+        "str", "strh", "strb", "ldrsb", "ldr", "ldrh", "ldrb", "ldrsh"
+        };
+    static UCHAR LsSize[8] = { 4, 2, 1, 1, 4, 2, 1, 2 };
+
+    if (Op < 0x10) {
+
+        //
+        // Shift (immediate), add, subtract, move and compare.
+        //
+
+        Opc = (Hw1 >> 9) & 0x1f;
+        Imm = (Hw1 >> 6) & 0x1f;
+        if (Opc < 12) {
+            if (Opc < 4 && Imm == 0) {
+
+                //
+                // MOVS (register), which an IT block may not hold.
+                //
+
+                Cond = 14;
+                OutputOp("mov", TRUE, NULL);
+                OutputRegs(2, Rd, Rn, 0, 0);
+            } else {
+                OutputOp(ShiftName[Opc >> 2], S, NULL);
+                OutputRegs(2, Rd, Rn, 0, 0);
+                OutputComma();
+                OutputImm(Imm == 0 ? 32 : Imm);
+            }
+        } else if (Opc < 16) {
+            OutputOp((Opc & 1) ? "sub" : "add", S, NULL);
+            OutputRegs(2, Rd, Rn, 0, 0);
+            OutputComma();
+            if (Opc < 14) {
+                OutputReg(Rm);
+            } else {
+                OutputImm(Rm);
+            }
+        } else {
+            Rd = (Hw1 >> 8) & 7;
+            switch (Opc >> 2) {
+            case 4:
+                OutputOp("mov", S, NULL);
+                OutputReg(Rd);
+                break;
+            case 5:
+                OutputOp("cmp", FALSE, NULL);
+                OutputReg(Rd);
+                break;
+            default:
+                OutputOp((Opc & 4) ? "sub" : "add", S, NULL);
+                OutputReg(Rd);
+                if ((Hw1 & 0xff) >= 8) {
+                    OutputComma();
+                    OutputReg(Rd);
+                }
+                break;
+            }
+            OutputComma();
+            OutputImm(Hw1 & 0xff);
+        }
+
+    } else if (Op == 0x10) {
+
+        //
+        // Data-processing.
+        //
+
+        Opc = (Hw1 >> 6) & 0xf;
+        switch (Opc) {
+        case 8:
+        case 10:
+        case 11:
+            OutputOp(DpName[Opc], FALSE, NULL);
+            OutputRegs(2, Rd, Rn, 0, 0);
+            break;
+        case 9:
+            OutputOp("rsb", S, NULL);
+            OutputRegs(2, Rd, Rn, 0, 0);
+            OutputComma();
+            OutputImm(0);
+            break;
+        case 13:
+            OutputOp("mul", S, NULL);
+            OutputRegs(3, Rd, Rn, Rd, 0);
+            break;
+        case 15:
+            OutputOp("mvn", S, NULL);
+            OutputRegs(2, Rd, Rn, 0, 0);
+            break;
+        default:
+            OutputOp(DpName[Opc], S, NULL);
+            OutputRegs(3, Rd, Rd, Rn, 0);
+            break;
+        }
+
+    } else if (Op == 0x11) {
+
+        //
+        // Special data instructions and branch and exchange.
+        //
+
+        Opc = (Hw1 >> 6) & 0xf;
+        Rd = ((Hw1 >> 4) & 8) | (Hw1 & 7);
+        Rm = (Hw1 >> 3) & 0xf;
+        if (Opc < 4) {
+            OutputOp("add", FALSE, NULL);
+            OutputRegs(3, Rd, Rd, Rm, 0);
+        } else if (Opc < 12) {
+            OutputOp(Opc < 8 ? "cmp" : "mov", FALSE, NULL);
+            OutputRegs(2, Rd, Rm, 0, 0);
+        } else {
+            OutputOp(Opc < 14 ? "bx" : "blx", FALSE, NULL);
+            OutputReg(Rm);
+        }
+
+    } else if (Op < 0x14) {
+
+        //
+        // Load literal.
+        //
+
+        OutputOp("ldr", FALSE, NULL);
+        OutputReg((Hw1 >> 8) & 7);
+        OutputComma();
+        OutputLiteral((Hw1 & 0xff) << 2, TRUE, 4);
+
+    } else if (Op < 0x18) {
