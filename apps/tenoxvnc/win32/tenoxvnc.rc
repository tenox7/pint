/*
 * tenoxvnc.rc - the icon and the dialogs.
 */

#include <windows.h>
#include "w32res.h"

IDI_TENOXVNC ICON "tenoxvnc.ico"

IDD_CONNECT DIALOG 0, 0, 220, 230
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TenoxVNC - Connect"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "", IDC_MESSAGE, 8, 6, 204, 9
    LTEXT           "&Server:", -1, 8, 21, 40, 8
    EDITTEXT        IDC_SERVER, 50, 19, 162, 12, ES_AUTOHSCROLL
    LTEXT           "&Password:", -1, 8, 37, 40, 8
    EDITTEXT        IDC_PASSWORD, 50, 35, 162, 12, ES_AUTOHSCROLL | ES_PASSWORD

    GROUPBOX        "Session", -1, 8, 52, 204, 38
    AUTOCHECKBOX    "S&hared", IDC_SHARED, 16, 63, 90, 10, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "&View only", IDC_VIEWONLY, 112, 63, 94, 10
    AUTOCHECKBOX    "&Continuous updates", IDC_CONTINUOUS, 16, 76, 90, 10
    AUTOCHECKBOX    "&Resize remote desktop", IDC_RESIZE, 112, 76, 96, 10

    GROUPBOX        "Encoding", -1, 8, 94, 204, 56
    AUTORADIOBUTTON "&Auto", IDC_ENC_AUTO, 16, 105, 36, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Tight", IDC_ENC_TIGHT, 54, 105, 36, 10
    AUTORADIOBUTTON "&ZRLE", IDC_ENC_ZRLE, 92, 105, 36, 10
    AUTORADIOBUTTON "He&xtile", IDC_ENC_HEXTILE, 130, 105, 42, 10
    AUTORADIOBUTTON "Ra&w", IDC_ENC_RAW, 174, 105, 34, 10
    AUTOCHECKBOX    "&JPEG", IDC_JPEG, 16, 120, 36, 10, WS_GROUP | WS_TABSTOP
    LTEXT           "&Quality:", IDC_QUALITY_LABEL, 60, 121, 32, 8
    COMBOBOX        IDC_QUALITY, 96, 119, 34, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Co&mpress:", -1, 60, 136, 32, 8
    COMBOBOX        IDC_COMPRESS, 96, 134, 34, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Color", -1, 8, 154, 204, 38
    AUTORADIOBUTTON "&Full", IDC_COLOR_FULL, 16, 165, 90, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Me&dium", IDC_COLOR_MEDIUM, 112, 165, 94, 10
    AUTORADIOBUTTON "&Low", IDC_COLOR_LOW, 16, 178, 90, 10
    AUTORADIOBUTTON "V&ery low", IDC_COLOR_VERYLOW, 112, 178, 94, 10

    DEFPUSHBUTTON   "Connect", IDOK, 106, 204, 50, 14, WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 162, 204, 50, 14
END

IDD_SETTINGS DIALOG 0, 0, 220, 184
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TenoxVNC - Settings"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "Session", -1, 8, 6, 204, 38
    AUTOCHECKBOX    "S&hared", IDC_SHARED, 16, 17, 90, 10, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "&View only", IDC_VIEWONLY, 112, 17, 94, 10
    AUTOCHECKBOX    "&Continuous updates", IDC_CONTINUOUS, 16, 30, 90, 10
    AUTOCHECKBOX    "&Resize remote desktop", IDC_RESIZE, 112, 30, 96, 10

    GROUPBOX        "Encoding", -1, 8, 48, 204, 56
    AUTORADIOBUTTON "&Auto", IDC_ENC_AUTO, 16, 59, 36, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Tight", IDC_ENC_TIGHT, 54, 59, 36, 10
    AUTORADIOBUTTON "&ZRLE", IDC_ENC_ZRLE, 92, 59, 36, 10
    AUTORADIOBUTTON "He&xtile", IDC_ENC_HEXTILE, 130, 59, 42, 10
    AUTORADIOBUTTON "Ra&w", IDC_ENC_RAW, 174, 59, 34, 10
    AUTOCHECKBOX    "&JPEG", IDC_JPEG, 16, 74, 36, 10, WS_GROUP | WS_TABSTOP
    LTEXT           "&Quality:", IDC_QUALITY_LABEL, 60, 75, 32, 8
    COMBOBOX        IDC_QUALITY, 96, 73, 34, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Co&mpress:", -1, 60, 90, 32, 8
    COMBOBOX        IDC_COMPRESS, 96, 88, 34, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Color", -1, 8, 108, 204, 38
    AUTORADIOBUTTON "&Full", IDC_COLOR_FULL, 16, 119, 90, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Me&dium", IDC_COLOR_MEDIUM, 112, 119, 94, 10
    AUTORADIOBUTTON "&Low", IDC_COLOR_LOW, 16, 132, 90, 10
    AUTORADIOBUTTON "V&ery low", IDC_COLOR_VERYLOW, 112, 132, 94, 10

    DEFPUSHBUTTON   "Apply", IDOK, 106, 158, 50, 14, WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 162, 158, 50, 14
END

IDD_PASSWORD DIALOG 0, 0, 180, 50
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TenoxVNC - Password"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "&Password:", -1, 8, 10, 40, 8
    EDITTEXT        IDC_PASSWORD, 50, 8, 122, 12, ES_AUTOHSCROLL | ES_PASSWORD
    DEFPUSHBUTTON   "OK", IDOK, 66, 28, 50, 14, WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 122, 28, 50, 14
END
