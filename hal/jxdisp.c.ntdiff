=1 130 1
+BOOLEAN HalpDisplaySerial = TRUE;
=1 138 1
+
+PULONG HalpFrameBuffer;
+ULONG HalpFramePitch;
+ULONG HalpFrameHeight;
+ULONG HalpForeground;
+ULONG HalpBackground;
+
+static ULONG
+HalpColor (
+    IN ULONG PixelOrder,
+    IN ULONG Red,
+    IN ULONG Green,
+    IN ULONG Blue
+    )
+{
+    if (PixelOrder == BCM_PIXEL_ORDER_RGB) {
+        return (Blue << 16) | (Green << 8) | Red;
+    }
+
+    return (Red << 16) | (Green << 8) | Blue;
+}
+
+static VOID
+HalpClearDisplay (
+    VOID
+    )
+{
+    ULONG Index;
+
+    for (Index = 0; Index < HalpFramePitch * HalpFrameHeight; Index += 1) {
+        HalpFrameBuffer[Index] = HalpBackground;
+    }
=1 694 3
+}
+
+static VOID
+HalpSerialOutput (
+    IN PUCHAR String
+    )
+{
+    for (; *String != 0; String += 1) {
+        if (*String == '\n') {
+            while ((HAL_REG(HAL_UART_BASE + 0x18) & 0x20) != 0) {
+            }
+            HAL_REG(HAL_UART_BASE) = '\r';
+        }
+
+        while ((HAL_REG(HAL_UART_BASE + 0x18) & 0x20) != 0) {
+        }
+        HAL_REG(HAL_UART_BASE) = *String;
=1 298 3 -4
