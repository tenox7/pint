#ntdiff private/ntos/nthals/halfxs/mips/jxdisp.c
=1 1 11
+    for the Raspberry Pi 2: the Jazz HAL's jxdisp.c over the VideoCore frame
+    buffer.
+
+    The display controller is the frame buffer the VideoCore allocated, which
+    the firmware describes in the configuration tree: 32 bits per pixel and
+    reached through KSEG0, so there is no display controller to program and
+    nothing to map. The display output is echoed to the serial console, unless
+    the kernel debugger owns the port.
=1 18 5
=1 25 3
+#include "bcmvdeo.h"
+#include "string.h"
+
=1 33 12
