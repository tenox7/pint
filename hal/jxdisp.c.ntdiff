=1 301 5
+    HalpFrameBuffer = (PULONG)(KSEG0_BASE | VideoData->FrameBase);
+    HalpFramePitch = VideoData->BytesPerScanLine / sizeof(ULONG);
+    HalpFrameHeight = HalpMonitorConfigurationData.VerticalResolution;
+    HalpForeground = HalpColor(VideoData->PixelOrder, 0xff, 0xff, 0xff);
+    HalpBackground = HalpColor(VideoData->PixelOrder, 0x00, 0x00, 0xaa);
=1 305 8
