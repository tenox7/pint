+    AdapterObject->MasterDevice = TRUE;
+    AdapterObject->ScatterGather = DeviceDescription->ScatterGather;
+    AdapterObject->MapRegistersPerChannel = BYTES_TO_PAGES(DeviceDescription->MaximumLength) + 1;
+    AdapterObject->MapRegisterBase = AdapterObject;
+    AdapterObject->BusMemoryBase = DeviceDescription->InterfaceType == PCIBus ||
+                                   (HalpBcm2711 && DeviceDescription->DmaChannel == SYSTEM_BUS_CHANNEL) ?
+                                   0 : BUS_MEMORY_BASE;
+    KeInitializeDeviceQueue(&AdapterObject->ChannelWaitQueue);
+
+    *NumberOfMapRegisters = AdapterObject->MapRegistersPerChannel;
=1 1280 1
+}
