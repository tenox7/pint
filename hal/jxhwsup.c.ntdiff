#ntdiff private/ntos/nthals/halfxs/mips/jxhwsup.c private/ntos/nthals/hal0jens/alpha/jxhwsup.c
=1 1 10
+    This module contains the HalpXxx routines for the NT I/O system that are
+    hardware dependent: the adapter objects and the bus address translation
+    of the Raspberry Pi 2 (the Jazz HAL's jxhwsup.c).
+
+    The buses are the Internal bus and, on a BCM2711 whose firmware brought up
+    its PCI Express link, the PCI buses (pcisup.c, pcibus.c), each with its bus
+    handler (busdata.c): the bus data and slot resources are those of the PCI
+    buses, and a PCI bus translates addresses as the Internal bus, its parent,
+    whose translation is here. Bus master devices
+    of the Internal bus reach memory through the VideoCore bus, which sees
+    SDRAM at BUS_MEMORY_BASE plus the physical address, but for the GENET of a
+    BCM2711, which is on its system bus and sees SDRAM at the physical address:
+    the firmware gives it the DMA channel SYSTEM_BUS_CHANNEL. Those of the PCI
+    bus reach it at the physical address (the inbound window of the root
+    complex). There is no I/O map, so a transfer maps directly and needs no map
+    registers. The PCI
+    memory is the HAL's window, which drivers use without mapping it, as the
+    QVAs of the Alpha HALs. There is no system (slave) DMA controller in the NT
+    sense.
=1 18 3
+    Kernel mode
=1 25 4
+
+//
+// The VideoCore bus address of physical address zero: the uncached alias of
+// SDRAM, which devices use for DMA.
+//
+
+#define BUS_MEMORY_BASE 0xC0000000
+
+//
+// The DMA channel of the bus masters of the Internal bus that reach memory
+// through the system bus of a BCM2711, at the physical address.
+//
+
+#define SYSTEM_BUS_CHANNEL 1
+
+//
+// The highest physical address a bus master can reach.
+//
+
+#define BUS_MEMORY_LIMIT 0x3FFFFFFF
+
