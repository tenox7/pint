=1 1766 15
+    to allow a transfer to or from a device. On the Pi the transfer maps to
+    the bus addresses of the pages directly, so a call maps the physically
+    contiguous run of pages at CurrentVa.
=1 1782 15
+    Length - Supplies the length of the transfer. This determines the
=1 1798 8
+    Returns the logical address that should be used bus master controllers.
=1 158 4
+    PHYSICAL_ADDRESS LogicalAddress;
+    PULONG PageFrame;
+    PULONG Next;
+    ULONG Offset;
+    ULONG Mapped;
+
+    UNREFERENCED_PARAMETER(MapRegisterBase);
+    UNREFERENCED_PARAMETER(WriteToDevice);
+
+    Offset = BYTE_OFFSET(CurrentVa);
+    PageFrame = (PULONG)(Mdl + 1) +
+                (((ULONG)CurrentVa - (ULONG)PAGE_ALIGN(Mdl->StartVa)) >> PAGE_SHIFT);
+
+    Mapped = PAGE_SIZE - Offset;
+    for (Next = PageFrame; Mapped < *Length && Next[1] == Next[0] + 1; Next += 1) {
+        Mapped += PAGE_SIZE;
+    }
+
+    if (Mapped < *Length) {
+        *Length = Mapped;
+    }
+
+    LogicalAddress.HighPart = 0;
+    LogicalAddress.LowPart = AdapterObject->BusMemoryBase | ((PageFrame[0] << PAGE_SHIFT) + Offset);
+    return LogicalAddress;
+}
