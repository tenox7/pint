+            strcpy(Buffer, (PCHAR)Value);
+            Status = ESUCCESS;
+        } else {
+            Status = ENOMEM;
=1 430 3
+    KeReleaseSpinLock(&HalpEnvironmentLock, OldIrql);
+    return Status;
+}
+
=1 442 11
+    An empty value deletes the variable. Called at or below APC level, it
+    writes the new environment to the SD card before it returns; the variable
+    is set even when that write fails (the environment then lasts until the
+    system restarts).
=1 453 15
+    ARC_STATUS Status = ESUCCESS;
+    PUCHAR Entry;
+    PUCHAR OldValue;
+    ULONG Index;
+    ULONG Size;
+    ULONG Used;
+    KIRQL OldIrql;
+
+    KeAcquireSpinLock(&HalpEnvironmentLock, &OldIrql);
+
+    //
+    // Remove the current definition, if any.
+    //
+
+    Entry = HalpFindVariable(Variable, &OldValue);
+    if (Entry != NULL) {
+        Size = strlen((PCHAR)Entry) + 1;
+        Used = HalpEnvironmentLength();
+        RtlMoveMemory(Entry, Entry + Size, Used + 1 - (Entry + Size - HalpEnvironment));
=1 162 3
+    // Append the new definition, the name in upper case, as the firmware keeps
+    // it and looks for it (arcfw\arm\jxenvir.c).
+    //
+
+    if (*Value != 0) {
+        Used = HalpEnvironmentLength();
+        Size = strlen(Variable) + 1 + strlen(Value) + 1;
+        if (Used + Size + 1 > LENGTH_OF_ENVIRONMENT) {
+            Status = ENOMEM;
+        } else {
+            Entry = HalpEnvironment + Used;
+            for (Index = 0; Variable[Index] != 0; Index += 1) {
+                Entry[Index] = UpCase(Variable[Index]);
+            }
+
+            Entry[Index] = '=';
+            strcpy((PCHAR)Entry + Index + 1, Value);
+            Entry[Size] = 0;
=1 430 3
+    KeReleaseSpinLock(&HalpEnvironmentLock, OldIrql);
+
+    //
+    // Have a worker thread write the new environment to the SD card, and wait
+    // until it has.
+    //
+
+    if ((Status == ESUCCESS) && (KeGetCurrentIrql() <= APC_LEVEL)) {
+        KeWaitForSingleObject(&HalpEnvironmentMutex,
+                              Executive,
+                              KernelMode,
+                              FALSE,
+                              NULL);
+
+        KeClearEvent(&HalpEnvironmentWritten);
+        ExInitializeWorkItem(&HalpEnvironmentWorkItem, HalpWriteEnvironment, NULL);
+        ExQueueWorkItem(&HalpEnvironmentWorkItem, DelayedWorkQueue);
+        KeWaitForSingleObject(&HalpEnvironmentWritten,
+                              Executive,
+                              KernelMode,
+                              FALSE,
+                              NULL);
+
+        KeReleaseMutex(&HalpEnvironmentMutex, FALSE);
+    }
+
+    return Status;
+}
