#ntdiff private/ntos/nthals/halfxs/mips/jxhalp.h private/ntos/nthals/hal0jens/alpha/jxhalp.h private/ntos/nthals/halfxs/mips/halp.h private/ntos/nthals/halalpha/halp.h
