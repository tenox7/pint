=1 90 1
+    HalpRestoreInterrupts(Psr);
+}
+
=1 95 11
+    This routine enables the specified system interrupt. The BCM2835
+    controller has no edge or level configuration, so the interrupt mode needs
+    no programming there. The GIC-400 is given the source's priority, its
+    processor and, for a shared peripheral interrupt, its mode. A source
+    interrupts above DISPATCH_LEVEL.
=1 107 12
+    TRUE if the system interrupt was enabled.
=1 50 4
+    ULONG Irq = Vector - DEVICE_VECTORS;
+    ULONG Configuration;
+    ULONG Bit;
+    ULONG Psr;
+
+    if (Vector < DEVICE_VECTORS || Irq > HalpMaximumVector() ||
+        Irql <= DISPATCH_LEVEL || Irql > HIGH_LEVEL) {
+        return FALSE;
+    }
+
+    Bit = 1 << HAL_VECTOR_BIT(Irq);
+    Psr = HalpDisableInterrupts();
=1 62 1
+    HalpVectorIrql[Irq] = Irql;
+    HalpEnabled[Irq / 32] |= Bit;
+    if (HalpBcm2711) {
+        HAL_REG8(HAL_GICD_IPRIORITYR(Irq)) = HalpGicPriority(Irql);
+        if (Irq >= HAL_GIC_FIRST_SPI) {
+            HAL_REG8(HAL_GICD_ITARGETSR(Irq)) = 1;
+            Configuration = HAL_REG(HAL_GICD_ICFGR(Irq / 16)) & ~(2 << ((Irq % 16) * 2));
+            if (InterruptMode == Latched) {
+                Configuration |= 2 << ((Irq % 16) * 2);
+            }
+
+            HAL_REG(HAL_GICD_ICFGR(Irq / 16)) = Configuration;
+        }
+
+        if ((HalpMasked(Irq / 32) & Bit) == 0) {
+            HAL_REG(HAL_GICD_ISENABLER(Irq / 32)) = Bit;
+        }
+
+    } else if ((HalpMasked(Irq / 32) & Bit) == 0) {
+        HAL_REG(HAL_VECTOR_BANK(Irq) == 2 ? HAL_IRQ_ENABLE2 : HAL_IRQ_ENABLE1) = Bit;
+    }
+
+    HalpComputeLevelSources();
=1 90 1
+    HalpRestoreInterrupts(Psr);
+    return TRUE;
+}
+
+ULONG
+HalpGetSystemInterruptVector (
+    IN PBUS_HANDLER BusHandler,
+    IN PBUS_HANDLER RootHandler,
=1 169 15
+    The interrupt vectors of the Internal bus (and of the processor's
+    internal bus) are the interrupt controller's IRQ numbers or interrupt
+    IDs, at the level the bus gives. A PCI bus, whose handler has this
+    function of its parent, gives the interrupt ID of the line a device
+    interrupts on (its interrupt line, which the firmware sets); its
+    interrupts are at DEVICE_LEVEL.
=1 40 3
+    BusHandler - Supplies the handler of the bus which the vector is for.
+
+    RootHandler - Supplies the handler of the bus of the request.
=1 189 16
+    INTERFACE_TYPE InterfaceType = BusHandler->InterfaceType;
+
+    UNREFERENCED_PARAMETER(RootHandler);
+
+    *Affinity = 1;
