#ntdiff private/ntos/nthals/halfxs/mips/jxsysint.c
=1 1 6
+    sysint.c
=1 8 3
+    This module implements the HAL interrupt support for the Raspberry Pi:
+    the interrupt controller behind the processor's IRQ input (the Jazz HAL's
+    jxsysint.c and its device interrupt dispatch), the BCM2835 interrupt
+    controller of the BCM2836 and BCM2837 or the GIC-400 of the BCM2711.
+
+    The BCM2835 controller has no priority logic and no end of interrupt, and
+    the processor has a single interrupt enable, so IRQL is held in the PCR and
+    enforced here as interrupts are dispatched (the lazy IRQL of the i386 HAL).
+    The kernel dispatches an IRQ through PCR->InterruptRoutine[IRQ_VECTOR] to
+    HalpInterruptDispatch, which takes the pending source of highest IRQL. If
+    it is above the current IRQL, the sources at or below its level are masked,
+    IRQL is raised to it and interrupts are enabled, so higher level interrupts
+    nest, while the routine connected to its vector, DEVICE_VECTORS + the IRQ
+    number, is called. Otherwise the pending sources at or below the current
+    IRQL are masked and their levels requested in the PCR; when IRQL drops below
+    a requested level, the kernel calls PCR->InterruptRoutine[level],
+    HalpUnmaskInterrupts, which unmasks them so they interrupt again. A source
+    is acknowledged at the device.
+
+    The GIC-400 orders the sources itself: each is given the priority of its
+    IRQL, the CPU interface presents the pending source of highest priority,
+    and until its end of interrupt only sources of a higher priority are
+    presented. HalpGicInterruptDispatch takes the source presented, whose
+    vector is DEVICE_VECTORS + its interrupt ID. If its level is above the
+    current IRQL, IRQL is raised to it and the routine connected to its vector
+    is called with interrupts enabled, then its interrupt ends. Otherwise its
+    interrupt ends at once, masked, with its level requested in the PCR, as
+    above.
+
+    On a multiprocessor the interrupts of the controllers reach processor 0,
+    and each processor has interrupts of its own, which the BCM2836 per-core
+    block delivers: its mailbox 0, which another processor sets to interrupt
+    it at IPI_LEVEL, and its generic virtual timer, the clock of a processor
+    other than 0 at CLOCK2_LEVEL. They are dispatched first, and one that
+    arrives at or below the current IRQL is masked in the per-core block and
+    requested in the PCR in the same way. The state of the controllers is
+    changed under the system interrupt lock, with interrupts disabled.
=1 18 3
+    Kernel mode only.
=1 24 4
+
+//
+// The IRQL each system interrupt vector was enabled at; by bank, the enabled
+// sources, those masked for IRQL and those of them that are requested; and,
+// for each IRQL, the enabled sources at or below it.
+//
+
+static KIRQL HalpVectorIrql[HAL_MAXIMUM_GIC_VECTOR + 1];
+static ULONG HalpEnabled[HAL_VECTOR_BANKS];
+static ULONG HalpMaskedShared[HAL_VECTOR_BANKS];
+static ULONG HalpRequestedShared[HAL_VECTOR_BANKS];
+
+//
+// Bank 0 of the GIC-400, its software generated and private peripheral
+// interrupts, is banked per processor: its masked and requested sources are
+// those of the processor, in the HAL part of its PCR. The other banks, and
+// every bank of the BCM2835 controller, hold the interrupts of processor 0.
+//
+
+#define HalpBankOfProcessor(Bank) (HalpBcm2711 && ((Bank) == 0))
+#define HalpMasked(Bank) (*(HalpBankOfProcessor(Bank) ? &PCR->HalReserved[3] : &HalpMaskedShared[Bank]))
+#define HalpRequested(Bank) (*(HalpBankOfProcessor(Bank) ? &PCR->HalReserved[4] : &HalpRequestedShared[Bank]))
+static ULONG HalpLevelSources[HIGH_LEVEL + 1][HAL_VECTOR_BANKS];
+
+//
+// An interrupt routine is called with its own address, which locates the
+// interrupt object of a connected vector (the MIPS a0), and the trap frame of
+// the interrupt (the MIPS s8).
+//
+
+typedef VOID (*PHALP_INTERRUPT_ROUTINE)(PVOID Routine, PKTRAP_FRAME TrapFrame);
+
+ULONG
+HalpDisableInterrupts (
+    VOID
+    );
+
+VOID
+HalpRestoreInterrupts (
+    IN ULONG Psr
+    );
+
+#define HalpEnableInterrupts() _enable()
+
+//
+// The highest interrupt number of the controller, and the GIC-400 priority of
+// an IRQL (a lower value is a higher priority; the non-secure view of the
+// GIC-400 holds sixteen levels).
+//
+
+#define HalpMaximumVector() (HalpBcm2711 ? HAL_MAXIMUM_GIC_VECTOR : HAL_MAXIMUM_BCM_VECTOR)
+#define HalpGicPriority(Irql) ((UCHAR)(0xF0 - ((Irql) << 4)))
+
+static VOID
+HalpMaskSources (
+    IN PULONG Sources
+    )
+{
+    ULONG Bank;
+
+    for (Bank = 0; Bank < HAL_VECTOR_BANKS; Bank += 1) {
+        if (Sources[Bank] == 0) {
+            continue;
+        }
+
+        HalpMasked(Bank) |= Sources[Bank];
+        if (HalpBcm2711) {
+            HAL_REG(HAL_GICD_ICENABLER(Bank)) = Sources[Bank];
+
+        } else {
+            HAL_REG(Bank == 0 ? HAL_IRQ_DISABLE1 : HAL_IRQ_DISABLE2) = Sources[Bank];
+        }
+    }
+}
+
+static VOID
+HalpUnmaskSources (
+    IN PULONG Sources
+    )
+{
+    ULONG Bank;
+    ULONG Bits;
+
+    for (Bank = 0; Bank < HAL_VECTOR_BANKS; Bank += 1) {
+        HalpMasked(Bank) &= ~Sources[Bank];
+        Bits = Sources[Bank] & HalpEnabled[Bank];
+        if (Bits == 0) {
+            continue;
+        }
+
+        if (HalpBcm2711) {
+            HAL_REG(HAL_GICD_ISENABLER(Bank)) = Bits;
+
+        } else {
+            HAL_REG(Bank == 0 ? HAL_IRQ_ENABLE1 : HAL_IRQ_ENABLE2) = Bits;
+        }
+    }
+}
+
+static VOID
+HalpComputeLevelSources (
+    VOID
+    )
+{
+    ULONG Vector;
+    ULONG Irql;
+
+    RtlZeroMemory(HalpLevelSources, sizeof(HalpLevelSources));
+    for (Vector = 0; Vector <= HalpMaximumVector(); Vector += 1) {
+        if ((HalpEnabled[Vector / 32] & (1 << HAL_VECTOR_BIT(Vector))) == 0) {
+            continue;
+        }
+
+        for (Irql = HalpVectorIrql[Vector]; Irql <= HIGH_LEVEL; Irql += 1) {
+            HalpLevelSources[Irql][Vector / 32] |= 1 << HAL_VECTOR_BIT(Vector);
+        }
+    }
+}
+
+static VOID
+HalpRequestSources (
+    IN PULONG Sources
=1 33 6
+    This routine masks sources at or below the current IRQL and requests their
+    levels, so that HalpUnmaskInterrupts unmasks them when IRQL drops below.
=1 50 4
+    ULONG Bank;
+    ULONG Bits;
+
+    HalpMaskSources(Sources);
+    for (Bank = 0; Bank < HAL_VECTOR_BANKS; Bank += 1) {
+        HalpRequested(Bank) |= Sources[Bank];
+        for (Bits = Sources[Bank]; Bits != 0; Bits &= Bits - 1) {
+            PCR->InterruptRequest |= 1 << HalpVectorIrql[Bank * 32 + (31 - _CountLeadingZeros(Bits & -(LONG)Bits))];
+        }
+    }
+}
+
+static VOID
+HalpInitializeGic (
+    VOID
=1 33 6
+    This routine masks every source of the GIC-400 and enables its distributor
+    and this processor's interface, which presents a source of any priority
+    the HAL gives. On a processor other than 0 only its banked sources and its
+    interface are initialized.
=1 50 4
+    ULONG Bank;
+
+    if (PCR->Number == 0) {
+        for (Bank = 0; Bank < HAL_VECTOR_BANKS; Bank += 1) {
+            HAL_REG(HAL_GICD_ICENABLER(Bank)) = 0xFFFFFFFF;
+        }
+
+        HAL_REG(HAL_GICD_CTLR) = 1;
+
+    } else {
+        HAL_REG(HAL_GICD_ICENABLER(0)) = 0xFFFFFFFF;
+    }
+
+    HAL_REG(HAL_GICC_PMR) = 0xF0;
+    HAL_REG(HAL_GICC_BPR) = 0;
+    HAL_REG(HAL_GICC_CTLR) = 1;
+}
+
+BOOLEAN
+HalpInitializeInterrupts (
+    VOID
=1 33 6
+    This function initializes interrupts for the Raspberry Pi: it masks every
+    source at the controllers, connects the interrupt dispatcher to the
+    processor's IRQ vector and the unmask routine to the levels above
+    DISPATCH_LEVEL, and starts the interval timer. It runs on each processor:
+    processor 0 initializes the controllers; each processor enables its own
+    interprocessor interrupt and, but processor 0, starts its clock.
=1 46 3
+    TRUE.
=1 50 4
+    PKPCR Pcr = PCR;
+    ULONG Irql;
+
+    if (HalpBcm2711) {
+        HalpInitializeGic();
+        Pcr->InterruptRoutine[IRQ_VECTOR] = (PKINTERRUPT_ROUTINE)HalpGicInterruptDispatch;
+        Pcr->InterruptRoutine[DEVICE_VECTORS + HAL_IPI_SGI] = (PKINTERRUPT_ROUTINE)HalpIpiInterrupt;
+
+    } else {
+        if (Pcr->Number == 0) {
+            HAL_REG(HAL_FIQ_CONTROL) = 0;
+            HAL_REG(HAL_IRQ_DISABLE1) = 0xFFFFFFFF;
+            HAL_REG(HAL_IRQ_DISABLE2) = 0xFFFFFFFF;
+            HAL_REG(HAL_IRQ_DISABLE_BASIC) = 0xFFFFFFFF;
+            HAL_REG(HAL_GPU_INT_ROUTING) = 0;
+        }
+
+        HAL_REG(HAL_CORE_TIMER_CTL(Pcr->Number)) = 0;
+        HAL_REG(HAL_CORE_MBOX_CTL(Pcr->Number)) = 0;
+        HAL_REG(HAL_CORE_MBOX_CLR(Pcr->Number, 0)) = 0xFFFFFFFF;
+        HalpLocalMasked = 0;
+        Pcr->InterruptRoutine[IRQ_VECTOR] = (PKINTERRUPT_ROUTINE)HalpInterruptDispatch;
+    }
+
+    Pcr->ReservedVectors |= (1 << IRQ_VECTOR);
+    for (Irql = DISPATCH_LEVEL + 1; Irql <= HIGH_LEVEL; Irql += 1) {
+        Pcr->InterruptRoutine[Irql] = (PKINTERRUPT_ROUTINE)HalpUnmaskInterrupts;
+        Pcr->ReservedVectors |= (1 << Irql);
+    }
+
+    if (Pcr->Number == 0) {
+        HalpStartClock();
+
+    } else {
+        HalpStartProcessorClock();
+    }
+
+    if (HalpBcm2711) {
+        HalEnableSystemInterrupt(DEVICE_VECTORS + HAL_IPI_SGI, IPI_LEVEL, Latched);
+
+    } else {
+        HAL_REG(HAL_CORE_MBOX_CTL(Pcr->Number)) = HAL_MBOX_CTL_MAILBOX0_IRQ;
+    }
+
+    return TRUE;
=1 73 3 -4
+// Mask and unmask the interrupts of the current processor itself in the
+// BCM2836 per-core block: its interprocessor interrupt and its clock.
+//
+
+static VOID
+HalpMaskLocal (
+    IN ULONG Local
+    )
+{
+    ULONG Number = PCR->Number;
+
+    if (Local & HAL_LOCAL_IPI) {
+        HAL_REG(HAL_CORE_MBOX_CTL(Number)) &= ~HAL_MBOX_CTL_MAILBOX0_IRQ;
+    }
+
+    if (Local & HAL_LOCAL_CLOCK) {
+        HAL_REG(HAL_CORE_TIMER_CTL(Number)) &= ~HAL_TIMER_CTL_CNTV_IRQ;
+    }
+
+    HalpLocalMasked |= Local;
+}
+
+static VOID
+HalpUnmaskLocal (
+    IN ULONG Local
+    )
+{
+    ULONG Number = PCR->Number;
+
+    HalpLocalMasked &= ~Local;
+    if (Local & HAL_LOCAL_IPI) {
+        HAL_REG(HAL_CORE_MBOX_CTL(Number)) |= HAL_MBOX_CTL_MAILBOX0_IRQ;
+    }
+
+    if (Local & HAL_LOCAL_CLOCK) {
+        HAL_REG(HAL_CORE_TIMER_CTL(Number)) |= HAL_TIMER_CTL_CNTV_IRQ;
+    }
+}
+
+static BOOLEAN
+HalpLocalInterruptDispatch (
+    IN PKTRAP_FRAME TrapFrame
=1 33 6
+    This function dispatches an interrupt of the current processor itself,
+    if one is pending, the interprocessor interrupt first: above the current
+    IRQL its routine is called at its level with interrupts enabled;
+    otherwise it is masked and its level requested.
=1 46 3
+    TRUE if an interrupt of the processor itself was pending.
=1 50 4
+    ULONG Source = HAL_REG(HAL_CORE_IRQ_SRC(PCR->Number));
+    PHALP_INTERRUPT_ROUTINE Service;
+    KIRQL OldIrql;
+    KIRQL Irql;
+    ULONG Local;
+
+    if (Source & HAL_IRQ_SRC_MAILBOX0) {
+        Local = HAL_LOCAL_IPI;
+        Irql = IPI_LEVEL;
+        Service = HalpIpiInterrupt;
+
+    } else if (Source & HAL_IRQ_SRC_CNTV) {
+        Local = HAL_LOCAL_CLOCK;
+        Irql = CLOCK2_LEVEL;
+        Service = HalpProcessorClockInterrupt;
+
+    } else {
+        return FALSE;
+    }
+
+    if (Irql <= PCR->CurrentIrql) {
+        HalpMaskLocal(Local);
+        PCR->InterruptRequest |= 1 << Irql;
+        return TRUE;
+    }
+
+    KeRaiseIrql(Irql, &OldIrql);
+    HalpEnableInterrupts();
+    Service((PVOID)Service, TrapFrame);
+    HalpDisableInterrupts();
+    return TRUE;
+}
+
+VOID
+HalpInterruptDispatch (
+    IN PVOID Routine,
+    IN PKTRAP_FRAME TrapFrame
=1 33 6
+    This function is entered from the kernel's IRQ entry with interrupts
+    disabled. It takes the pending source of the BCM2835 controller with the
+    highest IRQL. If its level is above the current IRQL, it masks the sources
+    at or below the level, raises IRQL to it and calls the routine connected
+    to the source's vector with interrupts enabled, then unmasks them; if no
+    enabled source is above the level, the routine runs with interrupts
+    disabled and nothing is masked. Otherwise it masks the pending sources at
+    or below the current IRQL and requests their levels. It returns with
+    interrupts disabled, and the kernel restores the previous IRQL.
=1 40 3
+    Routine - Supplies the address of this routine.
+
+    TrapFrame - Supplies a pointer to the trap frame of the interrupt.
=1 46 8
+    PHALP_INTERRUPT_ROUTINE Service;
+    ULONG Pending[HAL_VECTOR_BANKS];
+    ULONG Masked[HAL_VECTOR_BANKS];
+    ULONG Vector;
+    ULONG Best = (ULONG)-1;
+    KIRQL OldIrql;
+    KIRQL Irql;
+    ULONG Bank;
+    ULONG Bits;
+
+    if (HalpLocalInterruptDispatch(TrapFrame) ||
+        ((HAL_REG(HAL_CORE_IRQ_SRC(PCR->Number)) & HAL_IRQ_SRC_GPU) == 0)) {
+        return;
+    }
+
=1 62 1
+    RtlZeroMemory(Pending, sizeof(Pending));
+    Pending[0] = HAL_REG(HAL_IRQ_PEND1) & HalpEnabled[0] & ~HalpMasked(0);
+    Pending[1] = HAL_REG(HAL_IRQ_PEND2) & HalpEnabled[1] & ~HalpMasked(1);
+
+    for (Bank = 0; Bank < 2; Bank += 1) {
+        for (Bits = Pending[Bank]; Bits != 0; Bits &= Bits - 1) {
+            Vector = Bank * 32 + (31 - _CountLeadingZeros(Bits & -(LONG)Bits));
+            if (Best == (ULONG)-1 || HalpVectorIrql[Vector] > HalpVectorIrql[Best]) {
+                Best = Vector;
+            }
+        }
+    }
+
+    if (Best == (ULONG)-1) {
=1 90 1 4
+        return;
+    }
+
+    OldIrql = PCR->CurrentIrql;
+    Irql = HalpVectorIrql[Best];
+    if (Irql <= OldIrql) {
+        for (Bank = 0; Bank < HAL_VECTOR_BANKS; Bank += 1) {
+            Masked[Bank] = Pending[Bank] & HalpLevelSources[OldIrql][Bank];
+        }
+
+        HalpRequestSources(Masked);
=1 90 1 4
+        return;
+    }
+
+    Service = (PHALP_INTERRUPT_ROUTINE)PCR->InterruptRoutine[DEVICE_VECTORS + Best];
+    KeRaiseIrql(Irql, &OldIrql);
+    if (((HalpEnabled[0] & ~HalpLevelSources[Irql][0]) |
+         (HalpEnabled[1] & ~HalpLevelSources[Irql][1])) == 0) {
=1 90 1 4
+        Service((PVOID)Service, TrapFrame);
+        return;
+    }
+
+    for (Bank = 0; Bank < HAL_VECTOR_BANKS; Bank += 1) {
+        Masked[Bank] = HalpLevelSources[Irql][Bank] & ~HalpMasked(Bank);
+    }
+
+    HalpMaskSources(Masked);
=1 90 1
+    HalpEnableInterrupts();
+    Service((PVOID)Service, TrapFrame);
+    HalpDisableInterrupts();
=1 62 1
+    HalpUnmaskSources(Masked);
=1 90 1
+}
+
+VOID
+HalpGicInterruptDispatch (
+    IN PVOID Routine,
+    IN PKTRAP_FRAME TrapFrame
=1 33 6
+    This function is entered from the kernel's IRQ entry with interrupts
+    disabled. It takes the source the GIC-400 presents. If its level is above
+    the current IRQL, it raises IRQL to it and calls the routine connected to
+    the source's vector with interrupts enabled; the GIC-400 presents only
+    sources of a higher priority until the end of interrupt that follows.
+    Otherwise it masks the source, requests its level and ends its interrupt.
+    It returns with interrupts disabled, and the kernel restores the previous
+    IRQL.
=1 40 3
+    Routine - Supplies the address of this routine.
+
+    TrapFrame - Supplies a pointer to the trap frame of the interrupt.
=1 46 8
+    PHALP_INTERRUPT_ROUTINE Service;
+    ULONG Acknowledge = HAL_REG(HAL_GICC_IAR);
+    ULONG Vector = Acknowledge & 0x3FF;
+    ULONG Sources[HAL_VECTOR_BANKS];
+    KIRQL OldIrql;
+    KIRQL Irql;
+
+    if (Vector >= HAL_GIC_SPURIOUS) {
+        return;
+    }
+
+    if ((Vector > HAL_MAXIMUM_GIC_VECTOR) ||
+        ((HalpEnabled[Vector / 32] & (1 << HAL_VECTOR_BIT(Vector))) == 0)) {
+        HAL_REG(HAL_GICC_EOIR) = Acknowledge;
+        return;
+    }
+
+    Irql = HalpVectorIrql[Vector];
+    if (Irql <= PCR->CurrentIrql) {
+        RtlZeroMemory(Sources, sizeof(Sources));
+        Sources[Vector / 32] = 1 << HAL_VECTOR_BIT(Vector);
=1 62 1 4
+        HalpRequestSources(Sources);
=1 90 1 4
+        HAL_REG(HAL_GICC_EOIR) = Acknowledge;
+        return;
+    }
+
+    Service = (PHALP_INTERRUPT_ROUTINE)PCR->InterruptRoutine[DEVICE_VECTORS + Vector];
+    KeRaiseIrql(Irql, &OldIrql);
+    HalpEnableInterrupts();
+    Service((PVOID)Service, TrapFrame);
+    HalpDisableInterrupts();
+    HAL_REG(HAL_GICC_EOIR) = Acknowledge;
+}
+
+VOID
+HalpUnmaskInterrupts (
+    IN PVOID Routine,
+    IN PKTRAP_FRAME TrapFrame
=1 33 6
+    This function is called by the kernel, with interrupts disabled, when IRQL
+    drops below a level at which interrupts were requested. It unmasks the
+    requested sources above the current IRQL, which interrupt again if they
+    are still asserted. The interprocessor interrupt of the GIC-400 is a
+    software generated interrupt, which its acknowledgement consumed (it is
+    not asserted like a device's): it is sent again to this processor, so that
+    the requests it announced are processed. A processor at a raised IRQL
+    takes interrupts (KeInsertQueueDpc raises IRQL to HIGH_LEVEL), and the
+    interprocessor interrupts that arrive then would otherwise be lost, with
+    their senders waiting for them forever.
=1 40 3
+    Routine - Supplies the address of this routine.
+
+    TrapFrame - Not used.
=1 46 8
+    KIRQL Irql = PCR->CurrentIrql;
+    ULONG Unmask[HAL_VECTOR_BANKS];
+    ULONG Local = 0;
+    ULONG Bank;
+
+    if ((HalpLocalMasked & HAL_LOCAL_IPI) && (Irql < IPI_LEVEL)) {
+        Local |= HAL_LOCAL_IPI;
+    }
+
+    if ((HalpLocalMasked & HAL_LOCAL_CLOCK) && (Irql < CLOCK2_LEVEL)) {
+        Local |= HAL_LOCAL_CLOCK;
+    }
+
+    if (Local != 0) {
+        HalpUnmaskLocal(Local);
+    }
+
=1 62 1
+    for (Bank = 0; Bank < HAL_VECTOR_BANKS; Bank += 1) {
+        Unmask[Bank] = 0;
+        if ((PCR->Number == 0) || HalpBankOfProcessor(Bank)) {
+            Unmask[Bank] = HalpRequested(Bank) & ~HalpLevelSources[Irql][Bank];
+            HalpRequested(Bank) &= ~Unmask[Bank];
+        }
+    }
+
+    HalpUnmaskSources(Unmask);
+    if (HalpBcm2711 && (Unmask[0] & (1 << HAL_IPI_SGI)) != 0) {
+        HAL_REG(HAL_GICD_SGIR) = HAL_GICD_SGIR_SELF | HAL_IPI_SGI;
+    }
=1 89 2
+}
+
=1 29 25
+    ULONG Irq = Vector - DEVICE_VECTORS;
+    ULONG Bit;
+    ULONG Psr;
+
+    UNREFERENCED_PARAMETER(Irql);
+
+    if (Vector < DEVICE_VECTORS || Irq > HalpMaximumVector()) {
+        return;
+    }
+
+    Bit = 1 << HAL_VECTOR_BIT(Irq);
+    Psr = HalpDisableInterrupts();
=1 62 1
+    HalpEnabled[Irq / 32] &= ~Bit;
+    HalpMasked(Irq / 32) &= ~Bit;
+    HalpRequested(Irq / 32) &= ~Bit;
+    if (HalpBcm2711) {
+        HAL_REG(HAL_GICD_ICENABLER(Irq / 32)) = Bit;
+
+    } else {
+        HAL_REG(HAL_VECTOR_BANK(Irq) == 2 ? HAL_IRQ_DISABLE2 : HAL_IRQ_DISABLE1) = Bit;
+    }
+
