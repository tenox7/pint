#ntdiff private/ntos/nthals/hal0jens/alpha/jxclock.c private/ntos/nthals/halfxs/mips/j4prof.c private/ntos/nthals/halfxs/mips/xxclock.c
=1 1 6
+    clock.c
=1 8 3
+    This module implements the interval clock, the profile clock, the stall
+    and the performance counter of the Raspberry Pi HAL (the Jazz HAL's
+    x4clock.s, xxclock.c, xxcalstl.c and j4prof.c).
+
+    They run on the BCM2835 system timer: a 1 MHz free-running 64-bit counter
+    with four compare channels. Channel 3 drives the interval clock and
+    channel 1 the profile clock; a channel interrupts when the low word of the
+    counter equals its compare register and is acknowledged at the timer. The
+    interval clock of the BCM2711 is the processor's generic virtual timer,
+    which interrupts while its 64-bit count is at or past its compare value.
+
+    On a multiprocessor processor 0 keeps the system time; every other
+    processor keeps its run time by its own generic virtual timer, at the
+    maximum interval (the processor N clock of the Duo HAL's x4clock.s).
=2 17 5
=1 30 3
+
+#define TIMER_FREQUENCY 1000000
+
+//
+// The least time, in timer counts, between setting the clock compare and the
+// match: the timer interrupts only when the counter equals the compare, so a
+// compare it has passed would not interrupt again until the counter wraps.
+//
+
+#define CLOCK_COMPARE_MARGIN 100
+
+//
+// The rate of the generic timer when the firmware leaves its frequency
+// register unset: the BCM2711's 54 MHz crystal.
+//
+
+#define BCM2711_TIMER_FREQUENCY 54000000
+
+//
+// The rate of the generic timer when the firmware leaves its frequency
+// register unset on a BCM2836 or BCM2837: their 19.2 MHz crystal.
+//
+
+#define BCM2836_TIMER_FREQUENCY 19200000
+
+//
+// The generic timer registers: CNTFRQ, CNTV_CTL, CNTVCT and CNTV_CVAL.
+//
+
+#define HalpReadTimerFrequency() _MoveFromCoprocessor(15, 0, 14, 0, 0)
+#define HalpWriteVirtualTimerControl(v) _MoveToCoprocessor((v), 15, 0, 14, 3, 1)
+#define HalpReadVirtualCount() _MoveFromCoprocessor64(15, 1, 14)
+#define HalpWriteVirtualCompare(v) _MoveToCoprocessor64((v), 15, 3, 14)
=1 86 7
=3 35 1
=1 95 2
+//
+// The interval clock period and the profile interval in timer counts.
+//
+
+static ULONG HalpIntervalCount;
+static ULONG HalpMillisecondTicks;
+static ULONGLONG HalpClockCompare;
+static ULONG HalpClockVector;
+static ULONG HalpProfileVector;
+static ULONG HalpProfileCount;
+static BOOLEAN HalpProfileRunning;
+
=2 41 1
+
+//
+// The interval of the clock of a processor other than 0, in counts of its
+// generic timer; its next compare value is in its PCR.
+//
+
+static ULONG HalpProcessorInterval;
+
+#define HalpProcessorCompareLow (PCR->HalReserved[1])
+#define HalpProcessorCompareHigh (PCR->HalReserved[2])
+
+VOID
+HalpStartClock (
+    VOID
=1 101 6
+    This function connects the interval clock interrupt and starts the clock
+    at the maximum time increment.
=1 119 4
+    HalpCurrentTimeIncrement = MAXIMUM_INCREMENT;
+    HalpNewTimeIncrement = 0;
+    HalpIntervalCount = MAXIMUM_INCREMENT / 10;
+
+    if (HalpBcm2711) {
+        HalpMillisecondTicks = HalpReadTimerFrequency() / 1000;
+        if (HalpMillisecondTicks == 0) {
+            HalpMillisecondTicks = BCM2711_TIMER_FREQUENCY / 1000;
+        }
+
+        HalpClockVector = HAL_VIRTUAL_TIMER_ID;
+        HalpProfileVector = HAL_VIDEOCORE_ID(HAL_PROFILE_CHANNEL);
+        PCR->InterruptRoutine[DEVICE_VECTORS + HalpClockVector] = (PKINTERRUPT_ROUTINE)HalpGenericClockInterrupt;
+        PCR->InterruptRoutine[DEVICE_VECTORS + HalpProfileVector] = (PKINTERRUPT_ROUTINE)HalpProfileInterrupt;
+
+        HalpClockCompare = HalpReadVirtualCount() + (HalpIntervalCount / 1000) * HalpMillisecondTicks;
+        HalpWriteVirtualCompare(HalpClockCompare);
+        HalpWriteVirtualTimerControl(1);
+        __isb(_ARM_BARRIER_SY);
+        HalEnableSystemInterrupt(DEVICE_VECTORS + HalpClockVector, CLOCK2_LEVEL, LevelSensitive);
=1 309 3 4
+    HalpClockVector = HAL_CLOCK_CHANNEL;
+    HalpProfileVector = HAL_PROFILE_CHANNEL;
+    PCR->InterruptRoutine[DEVICE_VECTORS + HalpClockVector] = (PKINTERRUPT_ROUTINE)HalpClockInterrupt;
+    PCR->InterruptRoutine[DEVICE_VECTORS + HalpProfileVector] = (PKINTERRUPT_ROUTINE)HalpProfileInterrupt;
+
+    HAL_REG(HAL_ST_C3) = HAL_REG(HAL_ST_CLO) + HalpIntervalCount;
+    HalEnableSystemInterrupt(DEVICE_VECTORS + HalpClockVector, CLOCK2_LEVEL, Latched);
+}
+
+VOID
+HalpClockInterrupt (
+    IN PVOID Routine,
+    IN PKTRAP_FRAME TrapFrame
=1 101 6
+    This routine is entered as the result of an interrupt generated by the
+    interval timer. Its function is to acknowledge the interrupt, schedule the
+    next one, and transfer control to the standard system routine to update
+    the system time. A new time increment set by HalSetTimeIncrement takes
+    effect with the interval that starts now. Each compare follows the last by
+    the interval, so interrupt latency does not accumulate.
=1 111 3
+    Routine - Supplies the address of this routine.
+
+    TrapFrame - Supplies a pointer to a trap frame.
=1 115 8
+    ULONG TimeIncrement = HalpCurrentTimeIncrement;
+    ULONG Compare;
+    ULONG Lead;
+
+    HAL_REG(HAL_ST_CS) = 1 << HAL_CLOCK_CHANNEL;
+    if (HalpNewTimeIncrement != 0) {
+        HalpIntervalCount = HalpNextIntervalCount * (MINIMUM_INCREMENT / 10);
+        HalpCurrentTimeIncrement = HalpNewTimeIncrement;
+        HalpNewTimeIncrement = 0;
+    }
+
+    Compare = HAL_REG(HAL_ST_C3) + HalpIntervalCount;
+    Lead = Compare - HAL_REG(HAL_ST_CLO);
+    if (Lead < CLOCK_COMPARE_MARGIN || Lead > HalpIntervalCount) {
+        Compare = HAL_REG(HAL_ST_CLO) + HalpIntervalCount;
+    }
+
+    HAL_REG(HAL_ST_C3) = Compare;
+
+    //
+    // The counter may pass the compare before it is set (the processor held
+    // between the read and the write): then no match is pending, and the next
+    // compare is set from the counter again.
+    //
+
+    while (((LONG)(HAL_REG(HAL_ST_CLO) - Compare) > 0) &&
+           ((HAL_REG(HAL_ST_CS) & (1 << HAL_CLOCK_CHANNEL)) == 0)) {
+        Compare = HAL_REG(HAL_ST_CLO) + HalpIntervalCount;
+        HAL_REG(HAL_ST_C3) = Compare;
+    }
+
+    KeUpdateSystemTime(TrapFrame, TimeIncrement);
+}
+
+VOID
+HalpGenericClockInterrupt (
+    IN PVOID Routine,
+    IN PKTRAP_FRAME TrapFrame
=1 101 6
+    This routine is entered as the result of an interrupt generated by the
+    generic virtual timer, the interval clock of the BCM2711, as
+    HalpClockInterrupt is by the system timer. Setting the next compare value
+    ahead of the count acknowledges the interrupt.
=1 111 3
+    Routine - Supplies the address of this routine.
+
+    TrapFrame - Supplies a pointer to a trap frame.
=1 115 8
+    ULONG TimeIncrement = HalpCurrentTimeIncrement;
+    ULONGLONG Interval;
+    ULONGLONG Count;
+    ULONGLONG Compare;
+
+    if (HalpNewTimeIncrement != 0) {
+        HalpIntervalCount = HalpNextIntervalCount * (MINIMUM_INCREMENT / 10);
+        HalpCurrentTimeIncrement = HalpNewTimeIncrement;
+        HalpNewTimeIncrement = 0;
+    }
+
+    Interval = (HalpIntervalCount / 1000) * HalpMillisecondTicks;
+    Compare = HalpClockCompare + Interval;
+    Count = HalpReadVirtualCount();
+    if ((Compare <= Count) || ((Compare - Count) > Interval)) {
+        Compare = Count + Interval;
+    }
+
+    HalpClockCompare = Compare;
+    HalpWriteVirtualCompare(Compare);
+    __isb(_ARM_BARRIER_SY);
+    KeUpdateSystemTime(TrapFrame, TimeIncrement);
+}
+
+VOID
+HalpStartProcessorClock (
+    VOID
=1 101 6
+    This function starts the clock of a processor other than 0: its generic
+    virtual timer, at the maximum interval, whose interrupt the BCM2836
+    per-core block, or the GIC-400 as a private peripheral interrupt, delivers
+    to the processor.
=1 119 4
+    ULONG Frequency = HalpReadTimerFrequency();
+    ULONGLONG Compare;
+
+    if (Frequency == 0) {
+        Frequency = HalpBcm2711 ? BCM2711_TIMER_FREQUENCY : BCM2836_TIMER_FREQUENCY;
+    }
+
+    HalpProcessorInterval = (Frequency / 1000) * (MAXIMUM_INCREMENT / 10000);
+    Compare = HalpReadVirtualCount() + HalpProcessorInterval;
+    HalpProcessorCompareLow = (ULONG)Compare;
+    HalpProcessorCompareHigh = (ULONG)(Compare >> 32);
+    HalpWriteVirtualCompare(Compare);
+    HalpWriteVirtualTimerControl(1);
+    __isb(_ARM_BARRIER_SY);
+    if (HalpBcm2711) {
+        PCR->InterruptRoutine[DEVICE_VECTORS + HAL_VIRTUAL_TIMER_ID] =
+            (PKINTERRUPT_ROUTINE)HalpProcessorClockInterrupt;
+        HalEnableSystemInterrupt(DEVICE_VECTORS + HAL_VIRTUAL_TIMER_ID, CLOCK2_LEVEL, LevelSensitive);
+
+    } else {
+        HAL_REG(HAL_CORE_TIMER_CTL(PCR->Number)) = HAL_TIMER_CTL_CNTV_IRQ;
+    }
+}
+
+VOID
+HalpProcessorClockInterrupt (
+    IN PVOID Routine,
+    IN PKTRAP_FRAME TrapFrame
=1 101 6
+    This routine is entered as the result of an interrupt generated by the
+    clock of a processor other than 0. Setting the next compare value ahead of
+    the count acknowledges the interrupt; the kernel then bills the run time
+    of the processor (the Duo HAL's HalpClockInterrupt1).
=1 111 3
+    Routine - Supplies the address of this routine.
+
+    TrapFrame - Supplies a pointer to a trap frame.
=1 115 8
+    ULONGLONG Compare;
+    ULONGLONG Count;
+
+    Compare = (((ULONGLONG)HalpProcessorCompareHigh << 32) | HalpProcessorCompareLow) +
+              HalpProcessorInterval;
+    Count = HalpReadVirtualCount();
+    if ((Compare <= Count) || ((Compare - Count) > HalpProcessorInterval)) {
+        Compare = Count + HalpProcessorInterval;
+    }
+
+    HalpProcessorCompareLow = (ULONG)Compare;
+    HalpProcessorCompareHigh = (ULONG)(Compare >> 32);
+    HalpWriteVirtualCompare(Compare);
+    __isb(_ARM_BARRIER_SY);
+    KeUpdateRunTime(TrapFrame);
+}
+
