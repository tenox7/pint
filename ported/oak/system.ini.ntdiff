+            //
+            // The name space provider of TCP/IP in the catalog of Winsock 2 (OEMNXPTC.INF,
+            // AddNameSpaceProvider: WSCInstallNameSpace, which leaves StoresServiceClassInfo
+            // unset: FALSE), and the protocol catalog with WinSock\Setup Migration as setup
+            // leaves them: MigrateWinsockConfiguration (WSOCK32), which it calls after the
+            // binding review, over the transports Tcpip and NetBIOS (NetBT on Bcmeth1). The
+            // DHCP client opens its socket at the first boot, before a logon could run ws2setup.
+            //
+            WinSock2
+                Parameters
+                    WinSock_Registry_Version = 2.0
+                    Current_NameSpace_Catalog = NameSpace_Catalog5
+                    Current_Protocol_Catalog = Protocol_Catalog9
