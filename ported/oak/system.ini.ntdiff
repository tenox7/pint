#ntdiff public/oak/bin/system.ini ../nt35/PUBLIC/OAK/BIN/SYSTEM.INI
#crlf
=1 1 83
=2 101 2
+
+//
+// The Raspberry Pi 2, 3 and 4 (BCM2836, BCM2837, BCM2711): ARM machines whose disk is
+// the SD card on the Arasan SDHCI controller (the Bcmemmc SCSI miniport), whose display
+// is the VideoCore frame buffer (the Bcmvideo miniport) and whose keyboard and mouse are
+// USB devices (the Bcmusb keyboard and pointer port driver), without the PC peripherals.
+// Its system disk is made as a developer's: the hives hold what text mode setup and GUI
+// setup write into a retail system for the Pi (the code pages of TXTSETUP.SIF, the
+// processors of a 4 processor setup hive), and the first boot runs REGISTRY.INI.
+//
+#if defined(_RASPI_)
+#define RASPI 1
+#define BCMEMMC 1
+#define BCMVIDEO 1
+#define BCMUSB 1
+#endif // defined(_RASPI_)
=1 85 343
+#if defined(RASPI)
+//
+// All four cores of the Pi run NT: GUI setup registers and licenses the processors
+// the SystemPrefix of the setup hive allows (SetEnabledProcessorCount).
+//
+                RegisteredProcessors = REG_DWORD 4
+                LicensedProcessors = REG_DWORD 4
+#endif // defined(RASPI)
=1 427 47
+#if !defined(RASPI)
=2 487 2
+                    //
+                    // GUI setup appends the Windows directory to the path (SetUpPath).
+                    //
+                    Path = REG_EXPAND_SZ %SystemRoot%\system32;%SystemRoot%
+#endif // !defined(RASPI)
=1 475 133
+#if !defined(RASPI)
+                ProductType = WinNt
+#else
+//
+// The product type GUI setup writes for a workstation (SetProductTypeInRegistry): the
+// kernel matches it, case and all, to the product of the SystemPrefix below.
+//
+                ProductType = WinNT
+#endif // !defined(RASPI)
=2 535 43
=1 653 210
+#if defined(RASPI)
+                    //
+                    // What text setup writes from the [nls] section of TXTSETUP.SIF (USA):
+                    // the files of its code pages, then the code page of each kind.
+                    //
+                    ACP     = 1252
+                    437     = c_437.nls
+                    850     = c_850.nls
+                    OEMCP   = 437
+                    10000   = c_10000.nls
+                    MACCP   = 10000
+                    OEMHAL  = vgaoem.fon
+#endif // defined(RASPI)
=1 862 102
