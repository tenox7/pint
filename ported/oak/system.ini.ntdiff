=1 3581 60
+#if defined(RASPI)
+            //
+            // The network of the Pi as the network setup of NT 4.0 installs and binds it:
+            // NTLANMAN.INF with the INF of the Ethernet controller of the board (the Bcmeth
+            // miniport, adapter Bcmeth1), OEMNXPTC.INF for TCP/IP with DHCP and NetBIOS over
+            // TCP/IP, the services of LAN Manager, NetBIOS and RPC, then the binding review of
+            // the network control panel (the Linkage values, the LANA map of NetBIOS, the
+            // drivers it binds started at boot), without what DHCP writes while it runs. A
+            // service without a Security value gets the descriptor CreateService would have
+            // written (ScCreateScServiceObject); the INFs let users start NetBIOS, NtLmSsp and
+            // the RPC locator (SECURESVC 3, the descriptor of RpcSs). The developer first run
+            // writes the domain values of REGISTRY.INI (Domain, AccountDomainId) into the
+            // parameters of the workstation service, where the LSA reads them when it
+            // installs its database (LsapDbSetDomainInfo).
+            //
