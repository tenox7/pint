#ntdiff public/oak/bin/software.ini ../nt35/PUBLIC/OAK/BIN/SOFTWARE.INI
#crlf
=1 1 1921
+#if defined(_RASPI_)
+                    //
+                    // The adapter the network setup installs (NTLANMAN.INF, the INF of the
+                    // adapter: AddHardwareComponent).
+                    //
+                    1
+                        ServiceName = Bcmeth1
+                        Manufacturer = Microsoft
+                        Title = [1] Raspberry Pi Ethernet Adapter
+                        Description = Raspberry Pi Ethernet Adapter
+                        ProductName = Bcmeth
+                        OperationsSupport = REG_DWORD 0x00000086
+                        NetRules
+                            InfName = OEMNADBC.INF
+                            type = bcmeth bcmethAdapter
+                            bindform = "Bcmeth1" yes yes container
+                            class = REG_MULTI_SZ "bcmethAdapter basic"
+                            InfOption = BCMETH
+#endif // defined(_RASPI_)
=1 1922 386
+#if defined(_RASPI_)
+//
+// The first boot of the Pi is a developer's first boot, as with the developer hives of
+// NT 3.5: without a System value winlogon starts no LSA; it sets the system up from
+// REGISTRY.INI, writes System from DefaultSystem and restarts (InitializeDefaultRegistry).
+//
=2 1234 1
=1 2307 2
+#endif // defined(_RASPI_)
=1 2309 17
+#if defined(_RASPI_)
+//
+// GUI setup makes the profiles (Default User, All Users) and the items of the Start menu
+// a developer's first boot has none of: Repair, which text setup's repair of the Start
+// menu sets (spntfix.c), has winlogon make them (syssetup.dll RepairStartMenuItems).
+//
+                    Repair = REG_DWORD 1
+#endif // defined(_RASPI_)
=1 2326 45
+#if defined(_RASPI_)
+                    //
+                    // What text setup ([FontListE] of TXTSETUP.SIF) and GUI setup (font.inx,
+                    // [Font.CP1252.Reg.96]; syssetup.inx, [Fonts.Install]) add on a retail
+                    // system with small fonts: the Pi runs no GUI setup.
+                    //
=2 1310 7
+                    Arial (TrueType)=ARIAL.TTF
+                    Arial Bold (TrueType)=ARIALBD.TTF
+                    Arial Bold Italic (TrueType)=ARIALBI.TTF
+                    Arial Italic (TrueType)=ARIALI.TTF
+                    Courier New (TrueType)=COUR.TTF
+                    Courier New Bold (TrueType)=COURBD.TTF
+                    Courier New Bold Italic (TrueType)=COURBI.TTF
+                    Courier New Italic (TrueType)=COURI.TTF
+                    Lucida Console (TrueType)=LUCON.TTF
+                    Lucida Sans Unicode (TrueType)=L_10646.TTF
+                    Times New Roman (TrueType)=TIMES.TTF
+                    Times New Roman Bold (TrueType)=TIMESBD.TTF
+                    Times New Roman Bold Italic (TrueType)=TIMESBI.TTF
+                    Times New Roman Italic (TrueType)=TIMESI.TTF
+                    WingDings (TrueType)=WINGDING.TTF
+                    Symbol (TrueType)=SYMBOL.TTF
=2 1332 1
+
+                FontDPI
+                    LogPixels = REG_DWORD 0x00000060
+#endif // defined(_RASPI_)
=1 2371 481
+#if defined(_RASPI_)
+        //
+        // The network products of the network of the Pi (the network block of SYSTEM.INI)
+        // as their INFs register them (AddSoftwareComponent, the NetRules of the binding),
+        // and the state of the network control panel after its binding review (NTLANMAN.INF).
+        //
+        Bcmeth
+            CurrentVersion
+                ServiceName = Bcmeth
+                RefCount = REG_DWORD 0x00000001
+                SoftwareType = driver
+                MajorVersion = REG_DWORD 0x00000004
+                MinorVersion = REG_DWORD 0x00000000
+                Title = Raspberry Pi Ethernet Adapter Driver
+                Description = Raspberry Pi Ethernet Adapter Driver
+                NetRules
+                    InfName = OEMNADBC.INF
+                    type = bcmethSys ndisDriver bcmethDriver
+                    use = driver
+                    bindform = "BcmethSys" yes no container
+                    class = REG_MULTI_SZ "bcmethDriver basic"
+                    bindable = REG_MULTI_SZ "bcmethDriver bcmethAdapter non exclusive 100"
+                    InfOption = BCMETH
+        Browser
+            CurrentVersion
+                ServiceName = Browser
+                RefCount = REG_DWORD 0x00000000
+                SoftwareType = service
+                MajorVersion = REG_DWORD 0x00000004
+                MinorVersion = REG_DWORD 0x00000000
+                Title = Computer Browser
+                Description = Distributed protocol required for running the Computer Browser service.
+                OperationsSupport = REG_DWORD 0x00000084
+                NetRules
+                    InfName = oemnsvwk.inf
+                    InfOption = BROWSER
+        LanmanServer
+            CurrentVersion
+                ServiceName = LanmanServer
+                RefCount = REG_DWORD 0x00000000
+                SoftwareType = service
+                MajorVersion = REG_DWORD 0x00000004
+                MinorVersion = REG_DWORD 0x00000000
+                Title = Server
+                Description = Installs support for the SMB (Server Message Block) protocol, the core of Microsoft networking.
+                OperationsSupport = REG_DWORD 0x00000084
+                NetRules
+                    InfName = oemnsvsv.inf
+                    type = srv lmNetService lanmanServer
+                    class = REG_MULTI_SZ "lanmanServer lmNetService"
+                    use = service yes yes
+                    bindform = "LanmanServer" yes yes container
+                    InfOption = SRV
+        LanmanWorkstation
+            CurrentVersion
+                ServiceName = LanmanWorkstation
+                RefCount = REG_DWORD 0x00000000
+                SoftwareType = service
+                MajorVersion = REG_DWORD 0x00000004
+                MinorVersion = REG_DWORD 0x00000000
+                Title = Workstation
+                Description = Installs the client for the SMB (Server Message Block) protocol, the core of Microsoft networking.
+                OperationsSupport = REG_DWORD 0x00000084
+                NetRules
+                    InfName = oemnsvwk.inf
+                    type = wksta lmNetService lanmanWorkstation
+                    class = REG_MULTI_SZ "lanmanWorkstation lmNetService"
+                    use = service yes yes
+                    bindform = "LanmanWorkstation" yes yes container
+                    InfOption = WKSTA
+        Ncpa
+            CurrentVersion
+                NtlanmanInfName = REG_EXPAND_SZ NTLANMAN.INF
+                NcpaShelInfName = REG_EXPAND_SZ NCPASHEL.INF
+                RawRules = REG_MULTI_SZ "(devClass ndisDriver basic no)" \
+                                        "(devClass ndisTransport basic no)" \
+                                        "(devClass netBiosTransport ndisTransport no)" \
+                                        "(devClass lmNetService basic no)" \
+                                        "(bindable ndisTransport ndisDriver non non 100)" \
+                                        "(bindable lmNetService netBiosTransport non non 100)"
+                ReviewPrograms = REG_MULTI_SZ "NBINFO.INF"
+        NetBIOS
+            CurrentVersion
+                ServiceName = NetBIOS
+                RefCount = REG_DWORD 0x00000000
+                SoftwareType = service
+                MajorVersion = REG_DWORD 0x00000004
+                MinorVersion = REG_DWORD 0x00000000
+                Title = NetBIOS Interface
+                Description = Defines a software interface and naming convention for Microsoft networking.
+                OperationsSupport = REG_DWORD 0x00000086
+                NetRules
+                    InfName = oemnsvnb.inf
+                    type = netbios lmNetService
+                    use = service yes yes
+                    bindform = "Netbios" yes yes container
+                    InfOption = NETBIOS
+        NetBT
+            CurrentVersion
+                ServiceName = NetBT
+                RefCount = REG_DWORD 0x00000000
+                SoftwareType = transport
+                MajorVersion = REG_DWORD 0x00000004
+                MinorVersion = REG_DWORD 0x00000000
+                Hidden = REG_DWORD 0x00000001
+                Title = WINS Client(TCP/IP)
+                Description = NetBT System Driver
+                NetRules
+                    InfName = oemnxptc.inf
+                    type = netbt netBiosTransport netbtTransport
+                    use = transport none none
+                    bindform = "NetBT" yes yes simple
+                    class = REG_MULTI_SZ "netbtTransport netBiosTransport"
+                    InfOption = NETBT
+        RPCLOCATOR
+            CurrentVersion
+                ServiceName = RPCLOCATOR
+                RefCount = REG_DWORD 0x00000000
+                SoftwareType = service
+                MajorVersion = REG_DWORD 0x00000004
+                MinorVersion = REG_DWORD 0x00000000
+                Title = RPC Configuration
+                Description = Remote Procedure Call service enables RPC-written programs to perform procedures on multiple computers. Includes the endpoint mapper and other RPC services.
+                OperationsSupport = REG_DWORD 0x00000086
+                NetRules
+                    InfName = oemnsvrp.inf
+                    InfOption = RPCLOCATE
+        Tcpip
+            CurrentVersion
+                ServiceName = Tcpip
+                RefCount = REG_DWORD 0x00000000
+                SoftwareType = transport
+                MajorVersion = REG_DWORD 0x00000004
+                MinorVersion = REG_DWORD 0x00000000
+                Title = TCP/IP Protocol
+                Description = Transport Control Protocol/Internet Protocol. The default wide area network protocol that provides communication across diverse interconnected networks.
+                Review = REG_DWORD 0x00000001
+                OperationsSupport = REG_DWORD 0x00000086
+                NetRules
+                    InfName = oemnxptc.inf
+                    type = tcpip tcpipTransport
+                    use = transport none none
+                    bindform = "Tcpip" yes yes container
+                    bindable = REG_MULTI_SZ "tcpipService tcpipTransport non exclusive 100" \
+                                            "tcpipTransport ndisDriver non non 100"
+                    class = REG_MULTI_SZ "tcpipTransport basic" \
+                                         "tcpipService basic yes"
+                    InfOption = TC
+#endif // defined(_RASPI_)
=1 2851 21
+#if defined(_RASPI_)
+                //
+                // The LANA of the RPC protocol over NetBIOS on TCP/IP (OEMNXPTC.INF,
+                // AddMixRpcProtocol).
+                //
+                ncacn_nb_tcp0 = REG_DWORD 0x00000000
+#endif // defined(_RASPI_)
=1 2872 3
+#if defined(_RASPI_)
+                //
+                // The RPC protocols of TCP/IP (OEMNXPTC.INF, AddRpcProtocol and AddMixRpcProtocol).
+                //
+                ncacn_ip_tcp=RpcLtScm.Dll
+                ncadg_ip_udp=RpcLtScm.Dll
+                ncacn_nb_tcp=RpcLtScm.Dll
+#endif // defined(_RASPI_)
=1 2875 3
+#if defined(_RASPI_)
+                ncacn_ip_tcp=RpcLtCcm.Dll
+                ncadg_ip_udp=RpcLtCcm.Dll
+                ncacn_nb_tcp=rpcltccm.dll
+            //
+            // The security provider of RPC (OEMNSVRP.INF).
+            //
+            SecurityService
+                DefaultProvider = security.dll
+                10 = security.dll
+                DefaultAuthLevel = REG_DWORD 0x00000000
+#endif // defined(_RASPI_)
=1 2878 275
