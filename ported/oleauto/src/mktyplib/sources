# mktyplib.exe: the type library compiler of OLE Automation, which build\mktyplib.mak
# links for a WIN32 retail build (OBJS without tlviewer, CLIBS, OLELIBS: the NT tree's
# libraries, LOCALBUILD=FALSE) and runs to make stdole32.tlb. OLE Automation has no
# build.exe description in the tree; these are the flags of its WIN32 rules
# (MKTYPLIBCCFLAGS: -DWIN32, FV_UNICODE_OLE, _NTWIN, _WINDOWS; the NT headers after its
# own). A console program with main and the static C run-time (libc.lib).

TARGETNAME=mktyplib
TARGETPATH=obj
TARGETTYPE=PROGRAM
UMTYPE=console

INCLUDES=..\inc;$(BASEDIR)\public\sdk\inc;$(BASEDIR)\public\sdk\inc\crt

C_DEFINES=-DWIN32 -DFV_UNICODE_OLE=1 -D_NTWIN -D_WINDOWS

SOURCES=lexer.c      \
        intlstr.c    \
        mktyplib.c   \
        parser.c     \
        hout.c       \
        typout.cpp   \
        dimalloc.cxx \
        mktyplib.rc

# (oldnames.lib as its WIN32 link takes it: strdup, stricmp, tempnam)
TARGETLIBS=$(BASEDIR)\public\sdk\lib\*\oldnames.lib \
           $(BASEDIR)\public\sdk\lib\*\user32.lib   \
           $(BASEDIR)\public\sdk\lib\*\comdlg32.lib \
           $(BASEDIR)\public\sdk\lib\*\oleaut32.lib \
           $(BASEDIR)\public\sdk\lib\*\ole32.lib    \
           $(BASEDIR)\public\sdk\lib\*\uuid.lib
