# The dispatch half of oleaut32.dll (OLEDISP_OBJS of build\win32.mak), as a library
# the typelib directory links into the DLL. OLE Automation has no build.exe
# description in the tree: its own makefile builds it, with these flags for a RISC
# machine (DISPCLFLAGS, a retail build), the NT headers ahead of its own
# (LOCALBUILD=FALSE: TARGINC before OLEAUTOINC), the C version of the conversions
# (win32\oleconva.cpp) and the invoke of the machine (sources.arm).

TARGETNAME=oledisp
TARGETPATH=obj
TARGETTYPE=LIBRARY

INCLUDES=..;$(BASEDIR)\public\sdk\inc;$(BASEDIR)\public\sdk\inc\crt;..\..\inc

C_DEFINES=-DWIN32 -DINC_OLE2 -D_DLL -D_MT -DUNICODE -DVBA2=1 -DID_DEBUG=0

SOURCES=oledisp.cpp   \
        psfactry.cpp  \
        dispmrsh.cpp  \
