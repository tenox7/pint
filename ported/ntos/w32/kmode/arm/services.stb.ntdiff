#ntdiff private/ntos/w32/kmode/mips/services.stb
#crlf
=1 1 6
+//    sysstubs.asm, usrstubs.asm
=1 8 3
+//    The system service stub procedures of win32k.sys. A user mode stub
+//    executes svc with the number of the service in the second table
+//    (0x1000 and the number in the table) in r12; there are no kernel mode
+//    stubs.
=1 12 13
+#include "kxarm.h"
=1 26 10
+#define STUBS_END END
=1 37 10
+#define USRSTUBS_ENTRY1( ServiceNumber, Name, NumArgs) USRSTUB Zw##Name, Nt##Name, ServiceNumber + 0x1000
+#define USRSTUBS_ENTRY2( ServiceNumber, Name, NumArgs)
+#define USRSTUBS_ENTRY3( ServiceNumber, Name, NumArgs)
+#define USRSTUBS_ENTRY4( ServiceNumber, Name, NumArgs)
+#define USRSTUBS_ENTRY5( ServiceNumber, Name, NumArgs)
=1 52 4
+        MACRO
+        USRSTUB $Zw, $Nt, $Number
+        LEAF_ENTRY $Zw
+        ALTERNATE_ENTRY $Nt
+        movw    r12, #$Number
+        svc     #1
+        bx      lr
+        LEAF_END $Zw
+        MEND
+
+        TEXTAREA
=1 56 9
