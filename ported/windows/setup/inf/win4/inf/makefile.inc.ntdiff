#ntdiff private/windows/setup/inf/win4/inf/makefile.inc
#crlf
=1 1 13
+#
+# The platform switch of prodfilt, which takes the first letter of its tag: that of
+# arm is the one of alpha, so the lines of ARM are @r:.
+#
+!IF "$(TARGET_DIRECTORY)" == "arm"
+PLATSWITCH=r
+!ELSE
+PLATSWITCH=$(TARGET_DIRECTORY)
+!ENDIF
=1 13 58
+    prodfilt $(@B).tmp2 $@ +$(PLATSWITCH)
=1 72 14
+    prodfilt $(@B).tmp2 $@ +$(PLATSWITCH)
=1 87 6
+    prodfilt $(@B).tmp $@ +$(PLATSWITCH)
=1 94 11
+    prodfilt $(@B).tmp $@ +$(PLATSWITCH)
=1 106 5
+    prodfilt $(@B).tmp $@ +$(PLATSWITCH)
=1 94 3
+# the files the setup source of ARM has not are platform lines of optional.inx
=1 115 1
=1 92 1
+    prodfilt $(@B).tmp $@ +$(PLATSWITCH)
=1 94 3
+# the files the setup source of ARM has not are platform lines of accessor.inx
=1 119 1
=1 92 1
+    prodfilt $(@B).tmp $@ +$(PLATSWITCH)
=1 94 3
+# the files the setup source of ARM has not are platform lines of communic.inx
=1 123 1
=1 92 1
+    prodfilt $(@B).tmp $@ +$(PLATSWITCH)
=1 94 3
+# the files the setup source of ARM has not are platform lines of games.inx
=1 127 1
=1 92 1
+    prodfilt $(@B).tmp $@ +$(PLATSWITCH)
=1 94 3
=1 131 2
+    prodfilt $(@B).tmp $@ +$(PLATSWITCH)
=1 134 7
+# the files the setup source of ARM has not are platform lines of mmopt.inx
=1 141 1
=1 92 1
+    prodfilt $(@B).tmp $@ +$(PLATSWITCH)
=1 94 3
=1 145 7
+    prodfilt $(@B).tmp2 $@ +$(PLATSWITCH)
=1 75 4
+# the files the setup source of ARM has not are platform lines of multimed.inx
=1 157 1
=1 92 1
+    prodfilt $(@B).tmp $@ +$(PLATSWITCH)
=1 94 3
=1 161 4
+# the converters and the help files of wordpad.inx are platform lines: they are not on ARM
=1 165 1
=1 92 1
+    prodfilt $(@B).tmp $@ +$(PLATSWITCH)
=1 94 3
=1 169 39
+    prodfilt $(@B).tmp2 $@ +$(PLATSWITCH)
=1 209 8
+    prodfilt $(@B).tmp2 $@ +$(PLATSWITCH)
=1 218 14
+    prodfilt txtsetup.tmp1 txtsetup.tmp2 +$(PLATSWITCH)
=1 233 18
+    prodfilt dosnet.tmp1 dosnet.tmp2 +$(PLATSWITCH)
=1 252 9
