#ntdiff PRIVATE/WINDOWS/SETUP/INF/BETA/INITIAL.INF
=1 1 66
+;    6.  STF_PLATFORM:       I386 | MIPS | Alpha | Arm
=1 68 106
+    ProcessorID_CortexA7  = Cortex_A7
+    ProcessorID_CortexA53 = Cortex_A53
+    ProcessorID_CortexA72 = Cortex_A72
=1 174 9
+    PlatformID_Arm = Arm
=1 183 64
+[DestSizeVarsArm]
=1 237 290
+    else-ifstr(i) $(STF_PROCESSOR) == $(ProcessorID_CortexA7)
+        ifstr(i) $(STF_PLATFORM) != $(PlatformID_Arm)
=1 471 7
+        set STF_PRNPLATFORM = "w32arm"
+        set STF_PRNENVIRONM = "Windows NT ARM"
+
+    else-ifstr(i) $(STF_PROCESSOR) == $(ProcessorID_CortexA53)
+        ifstr(i) $(STF_PLATFORM) != $(PlatformID_Arm)
=1 471 7
+        set STF_PRNPLATFORM = "w32arm"
+        set STF_PRNENVIRONM = "Windows NT ARM"
+
+    else-ifstr(i) $(STF_PROCESSOR) == $(ProcessorID_CortexA72)
+        ifstr(i) $(STF_PLATFORM) != $(PlatformID_Arm)
=1 471 7
+        set STF_PRNPLATFORM = "w32arm"
+        set STF_PRNENVIRONM = "Windows NT ARM"
=1 526 722
+    else-ifstr(i) $(!STF_PLATFORM) == $(!PlatformID_Arm)
=1 1247 1703
