#ntdiff private/windows/setup/inf/beta/ncpashel.inf
#crlf
=1 1 89
+;    13. STF_PLATFORM:       I386 | MIPS | Alpha | ppc | Arm
+;
+;    14. STF_PROCESSOR:      I386 | I486 | I586  or R2000 | R3000 | R4000 | Alpha_AXP | Cortex_A7 | Cortex_A53 | Cortex_A72.
=1 93 96
+    !ProcessorID_CortexA7  = Cortex_A7
+    !ProcessorID_CortexA53 = Cortex_A53
+    !ProcessorID_CortexA72 = Cortex_A72
=1 188 5
+    !PlatformID_Arm    = Arm
=1 193 232
+     else-ifstr(i) $(!STF_PROCESSOR) == $(!ProcessorID_CortexA7)
+         set !STF_PLATFORM = $(!PlatformID_Arm)
+         set !SYS      = $(!ProcessorID_CortexA7)
+     else-ifstr(i) $(!STF_PROCESSOR) == $(!ProcessorID_CortexA53)
+         set !STF_PLATFORM = $(!PlatformID_Arm)
+         set !SYS      = $(!ProcessorID_CortexA53)
+     else-ifstr(i) $(!STF_PROCESSOR) == $(!ProcessorID_CortexA72)
+         set !STF_PLATFORM = $(!PlatformID_Arm)
+         set !SYS      = $(!ProcessorID_CortexA72)
=1 425 209
