+// Define the page table entry format for memory management: the R4000
+// EntryLo layout, so the memory manager's page tables are exactly the MIPS
+// ones. Dirty is the hardware write enable; Write and CopyOnWrite are
+// software bits. The ARMv7-A MMU does not walk these tables: the TB miss
+// handler copies a valid entry into a small page descriptor.
+//
+//   ARMv7-A small page descriptor       <-  HARDWARE_PTE
+//   [1:0]   = 0b10 (small page)             Valid
+//   [3:2] C,B  [8:6] TEX                    CachePolicy (UNCACHED_POLICY = device)
+//   [5:4] AP[1:0], [9] AP[2]                Dirty (writable), user below 2 GB
+//   [11]    nG                              !Global, or a per-process region
+//   [31:12] page base                       PageFrameNumber
=1 663 13
+// Define macro to initialize page directory table base.
=1 677 9
+// end_nthal
=3 703 3
+// Define address space layout: user space below 2 GB, KSEG0 the cached
+// direct map of physical memory, KSEG2 the mapped system space.
=1 859 8
+//
+// Define the processor types reported by SystemProcessorInformation: the
+// core's part number, MIDR[15:4].
+//
+
+#define PROCESSOR_ARM_CORTEX_A7 0xC07 // winnt
+#define PROCESSOR_ARM_CORTEX_A53 0xD03 // winnt
+
+//
+// Define ARM exception handling structures and function prototypes.
+//
+// Function table entry structure definition: the .pdata entry the compiler
+// makes for each function, the image relative address of the function, with
+// the Thumb state bit set, and either the image relative address of its
+// unwind data in .xdata (the low two bits clear) or, for a function of
+// canonical form, the packed unwind data (the low two bits not clear).
=1 872 4
+    ULONG UnwindData;
=1 880 3
+// Scope table structure definition: the data of the C specific handler,
+// which follows the address of the handler in the unwind data. The addresses
+// are image relative, with the Thumb state bit set. A handler address of one
+// is a filter that returns EXCEPTION_EXECUTE_HANDLER, and a jump target of
+// zero describes a termination handler.
=1 884 14
+// Nonvolatile register record: the nonvolatile registers of a frame, which
+// its exception filters and termination handlers address its locals with.
+//
+
+typedef struct _NONVOLATILE_REGISTERS {
+    ULONG R[8];
+    ULONGLONG D[8];
+} NONVOLATILE_REGISTERS, *PNONVOLATILE_REGISTERS;
+
+//
+// Define the context flag a virtual unwind sets when the program counter of
+// the context is the return address of a call.
+//
+
+#define CONTEXT_UNWOUND_TO_CALL 0x20000000
+
+//
+// Define the if-then execution state bits of the status register, which
+// continuing elsewhere than at the interrupted instruction clears.
+//
+
+#define CPSR_IT_MASK 0x0600fc00
=1 896 12
+    IN ULONG ControlPc,
