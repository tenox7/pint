#ntdiff PRIVATE/NTOS/KE/MIPS/INITKR.C PRIVATE/NTOS/KE/ALPHA/INITKR.C
=1 1 14
+    ARM32 / Raspberry Pi 2 port of KE/MIPS/INITKR.C. ARM deltas are marked
+    "ARM port:".
=1 14 9
=2 29 4
=1 40 18
+    routine, and then return to the system startup routine.
=1 61 30
=1 92 38
+    Prcb->PcrPage = LoaderBlock->u.Arm.PcrPage;
=1 131 4
=1 150 39
+        // Initialize the address of the interrupt dispatch routine.
=1 190 6
+        // and flush the dcache so the code is actually in memory.
=1 198 3
+            KxUnexpectedInterrupt.DispatchCode[Index] =
+                        ((PULONG)((ULONG)KiInterruptTemplate & ~1))[Index];
+        }
=1 208 6
+            (PKINTERRUPT_ROUTINE)((ULONG)(&KxUnexpectedInterrupt.DispatchCode) | 1);
=1 215 133
+    // If the current processor is 0, then set the appropriate bit in the active
=1 349 52
+    return;
+}
