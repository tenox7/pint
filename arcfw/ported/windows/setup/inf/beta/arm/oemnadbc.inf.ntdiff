#ntdiff PRIVATE/WINDOWS/SETUP/INF/BETA/MIPS/OEMNADSO.INF
=1 1 2
+; OEMNADBC.INF
+;
+;       Raspberry Pi Ethernet driver SETUP INF file.
=1 6 43
+    "BCM2836-Internal Bus"
+    "BCM2837-Internal Bus"
=1 50 11
+    BCMETH
=1 62 31
+ProductSoftwareName     = "Bcmeth"
+ProductSoftwareImagePath = "\SystemRoot\System32\drivers\bcmeth.sys"
+NetRuleSoftwareType     = "bcmethSys ndisDriver bcmethDriver"
=1 96 1
+NetRuleSoftwareBindForm = """BcmethSys"" yes no container"
+NetRuleSoftwareClass    = {"bcmethDriver basic"}
+NetRuleSoftwareBindable = {"bcmethDriver bcmethAdapter non exclusive 100"}
=1 100 3
+ProductHardwareName     = "Bcmeth"
+NetRuleHardwareType     = "bcmeth bcmethAdapter"
=1 105 1
+NetRuleHardwareClass    = {"bcmethAdapter basic"}
=1 107 167
+    Debug-Output "OEMNADBC.INF: STF_CWDIR is: "$(!STF_CWDIR)
+    Debug-Output "OEMNADBC.INF: STF_LANGUAGE is: "$(!STF_LANGUAGE)
=1 276 44
+            Debug-Output "Cannot configure the bcmeth driver software."
=1 321 623
