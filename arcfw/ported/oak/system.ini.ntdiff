#ntdiff PUBLIC/OAK/BIN/SYSTEM.INI PRIVATE/WINDOWS/SETUP/TEXTMODE/KERNEL/SETUPREG.INI
=1 1 14
+#if defined(_RASPI_)
+#define _HIVE_RASPI_
=1 14 2
+#endif // defined(_RASPI_)
=1 16 159
+// The Raspberry Pi 2 (BCM2836): an ARM machine whose disk is the SD card on the
+// Arasan SDHCI controller (the Bcmemmc SCSI miniport), whose display is the
+// VideoCore frame buffer (the Bcmvideo miniport) and whose keyboard and mouse are
+// USB devices on the USB host (the Bcmusb keyboard and pointer port driver),
+// without the PC peripherals.
+//
+
+#ifdef _HIVE_RASPI_
+#define RASPI 1
+#define BCMEMMC 1
+#define BCMVIDEO 1
+#define BCMUSB 1
=1 116 3
+#define CDFS 1
+#endif // _HIVE_RASPI_
=1 173 17
+    defined(MITSUMI) || defined(BCMEMMC)
=1 191 1058
+#if defined(RASPI)
+            //
+            // The Raspberry Pi 2 has no network yet: the workstation service is
+            // disabled, and its parameters hold the account domain of a developer
+            // install (registry.ini) for the LSA.
=1 1252 3
=1 1346 2
=1 1257 3
+#endif // defined(RASPI)
