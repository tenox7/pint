#ntdiff PRIVATE/NTOS/NTHALS/HAL0JENS/ALPHA/JXCLOCK.C PRIVATE/NTOS/NTHALS/HALFXS/MIPS/J4PROF.C PRIVATE/NTOS/NTHALS/HALFXS/MIPS/XXCLOCK.C
=1 1 6
+    clock.c
=1 8 3
+    This module implements the interval clock, the profile clock, the stall
+    and the performance counter of the Raspberry Pi 2 HAL (the Jazz HAL's
+    x4clock.s, xxclock.c, xxcalstl.c and j4prof.c).
+
+    All four run on the BCM2835 system timer: a 1 MHz free-running 64-bit
+    counter with four compare channels. Channel 3 drives the interval clock
+    and channel 1 the profile clock; a channel interrupts when the low word of
+    the counter equals its compare register and is acknowledged at the timer.
=2 17 5
=1 30 3
+
+#define TIMER_FREQUENCY 1000000
=1 86 7
=3 35 1
=1 95 2
+//
+// The interval clock period and the profile interval in timer counts.
+//
+
+static ULONG HalpIntervalCount;
+static ULONG HalpProfileCount;
+static BOOLEAN HalpProfileRunning;
+
=2 41 1
+
+VOID
+HalpStartClock (
+    VOID
=1 101 6
+    This function connects the interval clock interrupt and starts the clock
+    at the maximum time increment.
=1 119 4
+    HalpCurrentTimeIncrement = MAXIMUM_INCREMENT;
+    HalpNewTimeIncrement = 0;
+    HalpIntervalCount = MAXIMUM_INCREMENT / 10;
+
+    PCR->InterruptRoutine[DEVICE_VECTORS + HAL_CLOCK_IRQ] = (PKINTERRUPT_ROUTINE)HalpClockInterrupt;
+    PCR->InterruptRoutine[DEVICE_VECTORS + HAL_PROFILE_IRQ] = (PKINTERRUPT_ROUTINE)HalpProfileInterrupt;
+
+    HAL_REG(HAL_ST_C3) = HAL_REG(HAL_ST_CLO) + HalpIntervalCount;
+    HalEnableSystemInterrupt(DEVICE_VECTORS + HAL_CLOCK_IRQ, CLOCK2_LEVEL, Latched);
+}
+
+VOID
+HalpClockInterrupt (
+    IN PVOID Routine,
+    IN PKTRAP_FRAME TrapFrame
=1 101 6
+    This routine is entered as the result of an interrupt generated by the
+    interval timer. Its function is to acknowledge the interrupt, schedule the
+    next one, and transfer control to the standard system routine to update
+    the system time. A new time increment set by HalSetTimeIncrement takes
+    effect with the interval that starts now. Each compare follows the last by
+    the interval, so interrupt latency does not accumulate.
=1 111 3
+    Routine - Supplies the address of this routine.
+
+    TrapFrame - Supplies a pointer to a trap frame.
=1 115 8
+    ULONG TimeIncrement = HalpCurrentTimeIncrement;
+    ULONG Compare;
+
+    HAL_REG(HAL_ST_CS) = 1 << HAL_CLOCK_IRQ;
+    if (HalpNewTimeIncrement != 0) {
+        HalpIntervalCount = HalpNextIntervalCount * (MINIMUM_INCREMENT / 10);
+        HalpCurrentTimeIncrement = HalpNewTimeIncrement;
+        HalpNewTimeIncrement = 0;
+    }
+
+    Compare = HAL_REG(HAL_ST_C3) + HalpIntervalCount;
+    if ((Compare - HAL_REG(HAL_ST_CLO)) > HalpIntervalCount) {
+        Compare = HAL_REG(HAL_ST_CLO) + HalpIntervalCount;
+    }
+
+    HAL_REG(HAL_ST_C3) = Compare;
+    KeUpdateSystemTime(TrapFrame, TimeIncrement);
+}
+
=3 39 27
=3 67 4
=1 178 3
+
=1 181 4
=3 76 8
+
+VOID
+KeStallExecutionProcessor (
+    IN ULONG MicroSeconds
=1 101 6
+    This function stalls execution for the specified number of microseconds,
+    counting the 1 MHz system timer.
=1 111 3
+    MicroSeconds - Supplies the number of microseconds that execution is to be
+        stalled.
=1 115 8
+    ULONG Start = HAL_REG(HAL_ST_CLO);
+
+    while ((HAL_REG(HAL_ST_CLO) - Start) <= MicroSeconds) {
=1 260 3
=1 264 2
+    IN PLARGE_INTEGER Frequency OPTIONAL
=1 267 7
+    performance counter frequency: the 64-bit system timer and 1 MHz.
=1 275 8
+    The current performance counter value is returned as the function value.
=1 119 4
+    LARGE_INTEGER Count;
+    ULONG High;
+
+    do {
+        High = HAL_REG(HAL_ST_CHI);
+        Count.LowPart = HAL_REG(HAL_ST_CLO);
+        Count.HighPart = HAL_REG(HAL_ST_CHI);
+    } while (Count.HighPart != (LONG)High);
+
+    if (ARGUMENT_PRESENT(Frequency)) {
+        Frequency->LowPart = TIMER_FREQUENCY;
=1 314 3
+    return Count;
+}
+
=1 325 9
+    This routine synchronizes the performance counters of the processors in
+    the configuration. The system timer is one counter shared by every
+    processor, so there is nothing to synchronize.
=1 111 3
+    Number - Supplies a pointer to the count of the number of processors in
+        the configuration.
=1 115 8
+    UNREFERENCED_PARAMETER(Number);
+}
+
=1 364 22
=2 197 2
+    }
+
+    if (Interval > MAXIMUM_PROFILE_INTERVAL) {
=2 201 3
+    HalpProfileCount = Interval / 10;
+    HalpProfileInterval = HalpProfileCount * 10;
=2 217 2
+
=1 396 2
+    IN ULONG Reserved
=1 101 6
+    This routine starts the profile interrupt.
=1 111 3
+    Reserved - Reserved for future use.
=1 115 8
+    UNREFERENCED_PARAMETER(Reserved);
+
+    if (HalpProfileCount == 0) {
+        HalSetProfileInterval(HalpProfileInterval);
+    }
+
+    HalpProfileRunning = TRUE;
+    HAL_REG(HAL_ST_C1) = HAL_REG(HAL_ST_CLO) + HalpProfileCount;
+    HalEnableSystemInterrupt(DEVICE_VECTORS + HAL_PROFILE_IRQ, PROFILE_LEVEL, Latched);
+}
+
=1 449 2
+    IN ULONG Reserved
=1 101 6
+    This routine stops the profile interrupt.
=1 111 3
+    Reserved - Reserved for future use.
=1 115 8
+    UNREFERENCED_PARAMETER(Reserved);
+
+    HalpProfileRunning = FALSE;
+    HalDisableSystemInterrupt(DEVICE_VECTORS + HAL_PROFILE_IRQ, PROFILE_LEVEL);
+    HAL_REG(HAL_ST_CS) = 1 << HAL_PROFILE_IRQ;
+}
+
+VOID
+HalpProfileInterrupt (
+    IN PVOID Routine,
+    IN PKTRAP_FRAME TrapFrame
=1 101 6
+    This routine is entered as the result of an interrupt generated by the
+    profile timer. It acknowledges the interrupt, schedules the next one and
+    transfers control to the kernel's profile routine.
=1 111 3
+    Routine - Supplies the address of this routine.
+
+    TrapFrame - Supplies a pointer to a trap frame.
=1 115 8
+    HAL_REG(HAL_ST_CS) = 1 << HAL_PROFILE_IRQ;
+    if (HalpProfileRunning) {
+        HAL_REG(HAL_ST_C1) = HAL_REG(HAL_ST_CLO) + HalpProfileCount;
+        KeProfileInterrupt(TrapFrame);
+    }
+}
