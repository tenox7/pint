=1 747 5
+    This function allocates the memory for a common buffer and maps it so
+    that it can be accessed by a master device and the CPU. The buffer is
+    physically contiguous memory below the bus master limit; an uncached
+    buffer is mapped uncached.
=1 330 14
+    Returns the virtual address of the common buffer.  If the buffer cannot
+    be allocated then NULL is returned.
=1 158 4
+    PHYSICAL_ADDRESS Limit;
+    PHYSICAL_ADDRESS Physical;
+    PVOID VirtualAddress;
+    PVOID Uncached;
=2 633 2
+
+    Limit.HighPart = 0;
+    Limit.LowPart = BUS_MEMORY_LIMIT;
+    VirtualAddress = MmAllocateContiguousMemory(Length, Limit);
+    if (VirtualAddress == NULL) {
=1 557 3
+    Physical = MmGetPhysicalAddress(VirtualAddress);
+    if (!CacheEnabled) {
+        HalSweepDcacheRange(VirtualAddress, Length);
+        Uncached = MmMapIoSpace(Physical, Length, FALSE);
+        if (Uncached == NULL) {
=2 758 1 8
=1 557 3 4
+        VirtualAddress = Uncached;
+    }
+
+    LogicalAddress->HighPart = 0;
+    LogicalAddress->LowPart = BUS_MEMORY_BASE | Physical.LowPart;
+    return VirtualAddress;
+}
+
=1 665 8
=1 747 5
=1 677 7
+    Length - Supplies the length of the common buffer.
+
+    LogicalAddress - Supplies the logical address of the common buffer.
+
+    VirtualAddress - Supplies the virtual address of the common buffer.
=1 692 10
+    PHYSICAL_ADDRESS Physical;
=2 633 2
+
+    if (!CacheEnabled) {
+        MmUnmapIoSpace(VirtualAddress, Length);
+        Physical.HighPart = 0;
+        Physical.LowPart = LogicalAddress.LowPart & ~BUS_MEMORY_BASE;
+        VirtualAddress = (PVOID)(KSEG0_BASE | Physical.LowPart);
+    }
=2 757 2
+}
