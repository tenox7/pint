+    AdapterObject->MapRegistersPerChannel = BYTES_TO_PAGES(DeviceDescription->MaximumLength) + 1;
+    AdapterObject->MapRegisterBase = AdapterObject;
+    KeInitializeDeviceQueue(&AdapterObject->ChannelWaitQueue);
+
+    *NumberOfMapRegisters = AdapterObject->MapRegistersPerChannel;
=1 1279 1
+}
