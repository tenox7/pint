#ntdiff PRIVATE/NTOS/NTHALS/HALFXS/MIPS/JXHWSUP.C PRIVATE/NTOS/NTHALS/HAL0JENS/ALPHA/JXHWSUP.C
=1 1 10
+    This module contains the HalpXxx routines for the NT I/O system that are
+    hardware dependent: the adapter objects, bus address translation and bus
+    data of the Raspberry Pi 2 (the Jazz HAL's jxhwsup.c).
+
+    The buses are the Internal bus and, on a BCM2711 whose firmware brought up
+    its PCI Express link, the PCI bus (pcisup.c, pcibus.c). Bus master devices
+    of the Internal bus reach memory through the VideoCore bus, which sees
+    SDRAM at BUS_MEMORY_BASE plus the physical address, those of the PCI bus at
+    the physical address (the inbound window of the root complex); there is no
+    I/O map, so a transfer maps directly and needs no map registers. The PCI
+    memory is the HAL's window, which drivers use without mapping it, as the
+    QVAs of the Alpha HALs. There is no system (slave) DMA controller in the NT
+    sense.
=1 18 3
+    Kernel mode
=1 25 4
+
+//
+// The VideoCore bus address of physical address zero: the uncached alias of
+// SDRAM, which devices use for DMA.
+//
+
+#define BUS_MEMORY_BASE 0xC0000000
+
+//
+// The highest physical address a bus master can reach.
+//
+
+#define BUS_MEMORY_LIMIT 0x3FFFFFFF
+
