+    IN PVOID Routine,
=2 121 4
+HalpUnmaskInterrupts (
+    IN PVOID Routine,
=2 121 4
+HalpStartClock (
=1 78 4
+HalFlushDcachePage (
+    IN PVOID Color,
+    IN ULONG PageFrame,
+    IN ULONG Length
=1 69 3
+HalPurgeDcachePage (
+    IN PVOID Color,
+    IN ULONG PageFrame,
+    IN ULONG Length
=1 69 3
+HalPurgeIcachePage (
+    IN PVOID Color,
+    IN ULONG PageFrame,
+    IN ULONG Length
=3 168 6
=3 176 1
+extern BOOLEAN HalpDisplaySerial;
+
+#endif // _HALP_
