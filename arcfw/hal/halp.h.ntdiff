=1 46 4
=2 76 1
=2 78 1
=1 60 6
+VOID
+HalpClockInterrupt (
+    IN PVOID Routine,
=2 121 3
=3 106 16
+HalpInterruptDispatch (
+    IN PVOID Routine,
=2 121 4
