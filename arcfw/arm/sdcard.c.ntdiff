+    }
+    c1 = EMMC(CONTROL1) & ~(C1_CLK_EN | 0xFFE0);
+    SdWrite(CONTROL1, c1);
+    c1 |= ((divisor & 0xFF) << 8) | ((divisor >> 8) << 6) | C1_CLK_INTLEN | C1_TOUNIT_MAX;
+    SdWrite(CONTROL1, c1);
