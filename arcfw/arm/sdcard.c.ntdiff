+//
+static ULONG
+SdCapacity(
=2 1099 3
+    ULONG r1 = EMMC(RESP1), r2 = EMMC(RESP2);
+    ULONG size, mult, blockLength;
+
+    if (((EMMC(RESP3) >> 22) & 3) == 1) {
+        size = (r1 >> 8) & 0x3FFFFF;
+        return (size + 1) * 1024;
+    }
