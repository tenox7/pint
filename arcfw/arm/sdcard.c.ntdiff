+static ULONG
+SdGetPinFunction(
+    IN ULONG Pin
+    )
+{
+    return (GPFSEL(Pin) >> ((Pin % 10) * 3)) & 7;
+}
+
+static VOID
+SdSetPinFunction(
+    IN ULONG Pin,
+    IN ULONG Function
+    )
+{
+    ULONG shift = (Pin % 10) * 3;
+
+    GPFSEL(Pin) = (GPFSEL(Pin) & ~(7 << shift)) | (Function << shift);
+}
+
+static VOID
+SdWrite(
+    IN ULONG Register,
