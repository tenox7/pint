+// Issue a command; for a data command the caller moves the blocks afterwards.
+// An application command is prefixed with CMD55.
+//
+static BOOLEAN
+SdCommand(
+    IN ULONG Command,
+    IN ULONG Argument,
+    IN ULONG Blocks
+    )
+{
+    ULONG busy = STATUS_CMD_INHIBIT;
+    ULONG status;
+
+    if ((Command & APP) != 0 && !SdCommand(CMD(55) | R1, SdRca << 16, 0)) {
+        return FALSE;
+    }
+    Command &= ~APP;
+
+    if ((Command & (CMD_ISDATA | RSP_48_BUSY)) != 0) {
+        busy |= STATUS_DAT_INHIBIT;
