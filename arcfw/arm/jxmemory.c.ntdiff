=1 3 11
+    for the Raspberry Pi 2 (the ARM FW\MIPS\JXMEMORY.C).
+
+    Page 0 holds the exception vectors and page 1 the system parameter block;
+    the firmware image, its data and stack follow at 0x8000, where the GPU
+    loads it; the rest of the ARM's memory, whose size the VideoCore reports,
+    is free. A loaded program is described within the free memory.
=1 22 4
+
+extern char FwStart[];
=2 39 5
+static VOID
+FwpAddDescriptor (
=1 233 4
+{
+    PFW_MEMORY_DESCRIPTOR Descriptor = &FwMemoryTable[FwMemoryFree++];
+
+    Descriptor->MemoryEntry.MemoryType = MemoryType;
+    Descriptor->MemoryEntry.BasePage = BasePage;
+    Descriptor->MemoryEntry.PageCount = PageCount;
+    InsertTailList(&FwMemoryListHead, &Descriptor->ListEntry);
=1 343 3
=1 38 11
=1 57 3
+    ULONG Image = (ULONG)FwStart & ~3;
+    ULONG FirmwareBase = Image >> PAGE_SHIFT;
+    ULONG FirmwareEnd = (Image + ((PULONG)Image)[2] + PAGE_SIZE - 1) >> PAGE_SHIFT;
+    ULONG MemoryPages = MailboxGetArmMemory() >> PAGE_SHIFT;
=1 65 2
+    FwMemoryFree = 0;
+
+    //
+    // The exception vectors and the system parameter block.
+    //
+
+    FwpAddDescriptor(MemoryFirmwarePermanent, 0, 2);
+
+    //
+    // The memory below the firmware, where the GPU left the boot arguments.
+    //
+
+    FwpAddDescriptor(MemoryFree, 2, FirmwareBase - 2);
+
+    //
+    // The firmware code, data and stack.
+    //
+
+    FwpAddDescriptor(MemoryFirmwarePermanent, FirmwareBase, FirmwareEnd - FirmwareBase);
+
+    //
+    // The free memory above the firmware.
+    //
+
+    FwpAddDescriptor(MemoryFree, FirmwareEnd, MemoryPages - FirmwareEnd);
+
+    SYSTEM_BLOCK->FirmwareVector[MemoryRoutine] = (PVOID)FwGetMemoryDescriptor;
+}
