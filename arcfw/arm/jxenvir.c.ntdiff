#ntdiff private/ntos/fw/mips/jxenvir.c private/ntos/fw/alpha/jxenvir.c
=1 3 10
+    This module implements the ARC firmware environment variable functions
+    for the Raspberry Pi 2 (the ARM FW\MIPS\JXENVIR.C).
+
+    The environment is a list of "NAME=value" strings, each zero terminated,
+    names in upper case, followed by zeros. The Pi has no nonvolatile RAM, so
+    it is held in the firmware's memory and set at each power on to the boot
+    configuration Setup stores on a Jazz system.
=1 23 4
+#include "string.h"
+#include "ctype.h"
+
+#define LENGTH_OF_ENVIRONMENT 1024
+#define MAXIMUM_ENVIRONMENT_VALUE 256
+
+static CHAR Environment[LENGTH_OF_ENVIRONMENT];
+static CHAR VolatileEnvironment[LENGTH_OF_ENVIRONMENT];
+static CHAR OutputString[MAXIMUM_ENVIRONMENT_VALUE];
+
+//
+// The boot selection of a new install on the first partition: the loader and the HAL in
+// \os\winnt40, where NT 4.0 Setup puts them, and the system in \WINNT.
+//
+
+static PCHAR DefaultEnvironment[] = {
+    "SYSTEMPARTITION=scsi(0)disk(0)rdisk(0)partition(1)",
+    "OSLOADER=scsi(0)disk(0)rdisk(0)partition(1)\\os\\winnt40\\osloader.exe",
+    "OSLOADPARTITION=scsi(0)disk(0)rdisk(0)partition(1)",
+    "OSLOADFILENAME=\\WINNT",
+    "OSLOADOPTIONS=SOS",
+    "LOADIDENTIFIER=Windows NT Version 4.00",
+    "FWSEARCHPATH=scsi(0)disk(0)rdisk(0)partition(1)\\",
+    "AUTOLOAD=YES",
+    "COUNTDOWN=5",
+};
+
+static ARC_STATUS
=1 406 10
+    This routine searches (not case sensitive) the environment for Variable.
=1 65 3
+    ESUCCESS if found, with the indexes of the variable and of its value;
+    otherwise ENOENT.
=1 111 4
+    ULONG Index = 0;
+    PCHAR String;
+
+    while (Index < LENGTH_OF_ENVIRONMENT && Environment[Index] != 0) {
=1 457 1
+        for (String = Variable; *String != 0; String += 1, Index += 1) {
+            if (toupper(*String) != Environment[Index]) {
=1 272 4 4
+        if (*String == 0 && Environment[Index] == '=') {
+            *ValueIndex = Index + 1;
=1 487 3
+        while (Index < LENGTH_OF_ENVIRONMENT && Environment[Index] != 0) {
+            Index += 1;
+        }
+
+        Index += 1;
+    }
+
=1 444 3 -4
=1 150 9
+    This routine searches (not case sensitive) the environment for Variable,
+    and if found returns a pointer to a zero terminated string that contains
+    the value, otherwise a NULL pointer is returned.
=1 111 4
=1 178 4
+    if (FwFindEnvironmentVariable(Variable, &VariableIndex, &ValueIndex) != ESUCCESS) {
=1 190 3
+    for (Outdex = 0; Outdex < MAXIMUM_ENVIRONMENT_VALUE - 1; Outdex += 1) {
+        if (Environment[ValueIndex] == 0) {
=1 473 3 -4
+        OutputString[Outdex] = Environment[ValueIndex++];
+    }
=1 208 5
=1 214 10
+    This routine sets Variable (not case sensitive) to Value; an empty Value
+    deletes the variable.
=1 65 3
+    ESUCCESS, or ENOSPC if there is no space in the environment.
=1 111 4
=1 247 3
+    ULONG Count;
+
+    //
+    // Find the top of the environment: the end of its last string.
+    //
+
+    for (TopOfEnvironment = 0;
+         TopOfEnvironment < LENGTH_OF_ENVIRONMENT && Environment[TopOfEnvironment] != 0;
+         TopOfEnvironment += strlen(&Environment[TopOfEnvironment]) + 1) {
=1 133 3
+    // If the variable already has a value, remove it and compress the
+    // strings above it.
+    //
=1 290 2
+        Count = ValueIndex + strlen(&Environment[ValueIndex]) + 1 - VariableIndex;
+        memmove(&Environment[VariableIndex],
+                &Environment[VariableIndex + Count],
+                TopOfEnvironment - (VariableIndex + Count));
+        TopOfEnvironment -= Count;
+        memset(&Environment[TopOfEnvironment], 0, LENGTH_OF_ENVIRONMENT - TopOfEnvironment);
+    }
+
+    if (*Value == 0) {
=1 487 4 -4
+    // Append the variable, in upper case, and its value; one zero ends the
+    // string and another the environment.
+    //
+
+    if (TopOfEnvironment + strlen(Variable) + strlen(Value) + 3 > LENGTH_OF_ENVIRONMENT) {
+        return ENOSPC;
+    }
+
+    for (; *Variable != 0; Variable += 1) {
+        Environment[TopOfEnvironment++] = toupper(*Variable);
+    }
+
+    Environment[TopOfEnvironment++] = '=';
+    strcpy(&Environment[TopOfEnvironment], Value);
=1 401 3
=2 911 9
+    This routine copies the environment to a volatile area and returns its
+    address, for the envp of a program being executed.
=1 111 4
+    memcpy(VolatileEnvironment, Environment, LENGTH_OF_ENVIRONMENT);
+    return VolatileEnvironment;
+}
+
=1 51 9
+    This routine sets the power on environment and initializes the environment
+    entries of the firmware vector.
=1 111 4
+    PCHAR Equal;
+    CHAR Name[64];
+    ULONG Index;
+
+    memset(Environment, 0, LENGTH_OF_ENVIRONMENT);
+    for (Index = 0; Index < sizeof(DefaultEnvironment) / sizeof(DefaultEnvironment[0]); Index += 1) {
+        Equal = strchr(DefaultEnvironment[Index], '=');
+        memcpy(Name, DefaultEnvironment[Index], Equal - DefaultEnvironment[Index]);
+        Name[Equal - DefaultEnvironment[Index]] = 0;
+        FwSetEnvironmentVariable(Name, Equal + 1);
=1 133 3
+    // The console is the keyboard and the monitor when a keyboard is attached, as
+    // Setup configures a Jazz system with video, otherwise the serial port, as on a
+    // Jazz system with its configuration jumper set. The monitor then says so and
+    // lists the USB devices found.
+    //
+
+    if (DisplayOutput && UsbKeyboardPresent()) {
+        FwSetEnvironmentVariable("CONSOLEIN", "multi()key()keyboard()console()");
+        FwSetEnvironmentVariable("CONSOLEOUT", "multi()video()monitor()console()");
+    } else {
+        if (DisplayOutput) {
+            FwPrint("No USB keyboard: the console is the serial port.\r\n");
+            UsbPrintDevices();
+        }
+
+        FwSetEnvironmentVariable("CONSOLEIN", "multi(0)serial(0)");
+        FwSetEnvironmentVariable("CONSOLEOUT", "multi(0)serial(0)");
+    }
+
+    SYSTEM_BLOCK->FirmwareVector[GetEnvironmentRoutine] = (PVOID)FwGetEnvironmentVariable;
+    SYSTEM_BLOCK->FirmwareVector[SetEnvironmentRoutine] = (PVOID)FwSetEnvironmentVariable;
+}
