#ntdiff private/ntos/fw/mips/jxvendor.c private/ntos/fw/alpha/jxvendor.c
=1 3 10
+    Implementation of the vendor private routines for the Raspberry Pi 2 ARC
+    firmware (the ARM FW\MIPS\JXVENDOR.C). Execution is stalled on the
+    BCM2835 system timer, a free running 1 MHz counter.
=1 14 11
+#define SYSTEM_TIMER_CLO (*(volatile ULONG *)(PERIPHERAL_BASE + 0x3004))
=1 38 5
+PVOID GlobalVendorVectors[MaximumVendorRoutine];
+
+static __declspec(align(64)) UCHAR FwPool[FW_POOL_SIZE];
=1 43 3
=1 47 22
+
=1 69 4
+    FwPoolBase = (PCHAR)FwPool;
+    FwFreePool = (PCHAR)FwPool;
=1 75 6
+    SYSTEM_BLOCK->VendorVectorLength = sizeof(GlobalVendorVectors);
+    SYSTEM_BLOCK->VendorVector = GlobalVendorVectors;
+    SYSTEM_BLOCK->VendorVector[AllocatePoolRoutine] = (PVOID)FwAllocatePool;
+    SYSTEM_BLOCK->VendorVector[StallExecutionRoutine] = (PVOID)FwStallExecution;
+    SYSTEM_BLOCK->VendorVector[PrintRoutine] = (PVOID)FwPrint;
=1 90 3
=1 94 22
=1 117 26
+        FwFreePool += ((NumberOfBytes - 1) & ~(BlDcacheFillSize - 1)) +
+                      BlDcacheFillSize;
+    }
+
+    return Pool;
+}
+
+ULONG
+FwGetMicroseconds (
=1 49 7
+    This function returns the system timer count, in microseconds.
=1 65 4
+    return SYSTEM_TIMER_CLO;
+}
=1 33 4
=1 152 20
+    ULONG Start = SYSTEM_TIMER_CLO;
+
+    while ((SYSTEM_TIMER_CLO - Start) < MicroSeconds) {
+    }
+}
