+static ULONG
+FwPixel (
+    IN ULONG Color
=1 285 6
+    This routine returns the frame buffer pixel of a palette color.
=1 301 4
+    ULONG Rgb = Palette[Color & 15];
+
+    if (VideoData.PixelOrder == BCM_PIXEL_ORDER_RGB) {
+        return ((Rgb & 0xFF) << 16) | (Rgb & 0xFF00) | (Rgb >> 16);
+    }
+
+    return Rgb;
+}
