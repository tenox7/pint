+//
+// Define the display resolution used when the VideoCore reports none. The
+// resolution is that of the VideoCore's frame buffer: framebuffer_width and
+// framebuffer_height of config.txt, else the mode of the display.
+//
+
+#define FW_DISPLAY_WIDTH        1920
+#define FW_DISPLAY_HEIGHT       1080
+
