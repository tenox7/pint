+//
+// Define the G364 palette: the eight colors, then their high intensity.
+//
+
+static ULONG Palette[16] = {
+    0x000000, 0xB00000, 0x00B000, 0xB0B000, 0x0000B0, 0xB000B0, 0x00B0B0, 0xB0B0B0,
+    0x000000, 0xFF0000, 0x00FF00, 0xFFFF00, 0x0000FF, 0xFF00FF, 0x00FFFF, 0xFFFFFF
+};
+
+#define FW_COLOR_BLACK      0
+#define FW_COLOR_HI_WHITE   15
