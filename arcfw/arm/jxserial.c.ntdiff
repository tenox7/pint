=1 376 7
+    This routine initializes the serial port controller: it selects the UART
+    on GPIO 14 and 15 without pulls, and programs 115200 baud, eight bits,
+    no parity, one stop bit, with the fifos enabled and interrupts masked.
=1 384 10
+
+{
+    ULONG Select;
+
+    Select = GPFSEL1 & ~((7 << 12) | (7 << 15));
+    GPFSEL1 = Select | (4 << 12) | (4 << 15);
+    GPPUD = 0;
+    FwStallExecution(5);
+    GPPUDCLK0 = (1 << 14) | (1 << 15);
+    FwStallExecution(5);
+    GPPUDCLK0 = 0;
+
+    while ((UART_FR(SP) & 0x08) != 0) {
+    }
+
+    UART_CR(SP) = 0;
+    UART_ICR(SP) = 0x7FF;
+    UART_IBRD(SP) = 26;
+    UART_FBRD(SP) = 3;
+    UART_LCRH(SP) = LCRH_WLEN8 | LCRH_FEN;
+    UART_IMSC(SP) = 0;
+    UART_CR(SP) = CR_UARTEN | CR_TXE | CR_RXE;
