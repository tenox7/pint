=1 3 10
+    This module implements the serial boot driver for the Raspberry Pi 2 (the
+    ARM FW\MIPS\JXSERIAL.C) over the PL011 UART, serial port 0 on GPIO 14 and
+    15. Its reference clock is the 48 MHz the VideoCore gives it when the
+    UART is enabled (enable_uart=1), which runs it at 115200 baud.
=1 14 7
+    Kernel mode
=1 23 6
+
+//
+// Define the PL011 registers.
+//
+
+#define UART_DR(SP)     (*(volatile ULONG *)((SP) + 0x00))
+#define UART_FR(SP)     (*(volatile ULONG *)((SP) + 0x18))
+#define UART_IBRD(SP)   (*(volatile ULONG *)((SP) + 0x24))
+#define UART_FBRD(SP)   (*(volatile ULONG *)((SP) + 0x28))
+#define UART_LCRH(SP)   (*(volatile ULONG *)((SP) + 0x2C))
+#define UART_CR(SP)     (*(volatile ULONG *)((SP) + 0x30))
+#define UART_IMSC(SP)   (*(volatile ULONG *)((SP) + 0x38))
+#define UART_ICR(SP)    (*(volatile ULONG *)((SP) + 0x44))
+
+#define FR_TXFF         0x20
+#define FR_RXFE         0x10
+#define LCRH_FEN        0x10
+#define LCRH_WLEN8      0x60
+#define CR_UARTEN       0x001
+#define CR_TXE          0x100
+#define CR_RXE          0x200
+
+//
+// Define the GPIO registers that select the UART on pins 14 and 15.
+//
+
+#define GPFSEL1         (*(volatile ULONG *)(PERIPHERAL_BASE + 0x200004))
+#define GPPUD           (*(volatile ULONG *)(PERIPHERAL_BASE + 0x200094))
+#define GPPUDCLK0       (*(volatile ULONG *)(PERIPHERAL_BASE + 0x200098))
