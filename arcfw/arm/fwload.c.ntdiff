+    CHAR TempPath[256];
+    ARC_STATUS Status;
+
+    //
+    // Copy the arguments and the path to a safe place, as they can be in the
+    // running program space which can be overwritten by the program about to
+    // be loaded, and reinitialize the memory descriptors.
+    //
+
+    FwCopyArguments(Argc, Argv);
+    strncpy(TempPath, Path, sizeof(TempPath) - 1);
+    TempPath[sizeof(TempPath) - 1] = 0;
