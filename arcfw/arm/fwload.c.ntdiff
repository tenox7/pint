+ARC_STATUS
+FwInvoke (
+    IN ULONG ExecAddr,
+    IN ULONG StackAddr,
=1 856 9
+    This routine invokes a loaded program on the specified stack.
=1 257 3
+    ESUCCESS is returned when the program returns; EFAULT if its address is
+    not a valid instruction address: an ARM state address is word aligned and
+    a Thumb state address has its low bit set.
=1 263 4
+    if ((ExecAddr & 0x3) == 0x2) {
+        return EFAULT;
+    }
+
+    FwpTransfer(ExecAddr, StackAddr, Argc, Argv, Envp);
+    return ESUCCESS;
+}
